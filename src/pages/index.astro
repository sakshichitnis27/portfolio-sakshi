---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Dock from '../components/Dock.astro';
---

<Layout title="Sakshi Chitnis - Java Full Stack Developer" description="Java Full Stack Developer with 4+ years of experience building event-driven microservices, React frontends, Kafka pipelines, and cloud-native enterprise systems.">
  <Dock />
  <main>
    <Hero />
    <div id="about-driver">
      <About />
    </div>
    <div id="exp-driver">
      <Experience />
    </div>
    <div id="skills-driver">
      <Skills />
    </div>
    <Projects />
    <Contact />
  </main>
</Layout>
