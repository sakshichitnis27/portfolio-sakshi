---
import { journey } from '../data/portfolio';

// SVG path: M6 74 C14 58 20 26 28 40 C36 54 42 74 52 62 C62 50 62 16 74 26 C84 36 83 57 92 48
// stops[i].cx / cy  === on-curve bezier endpoints in SVG viewBox-100 space
// Because preserveAspectRatio="none" and viewBox 0 0 100 100:
//   SVG x=6 == CSS left=6%,  SVG y=74 == CSS top=74%
// dot width = 3rem => half = 1.5rem used in the translate math
// Overall arc: cy 74→40→62→26→48 — peaks at 40 & 26 get progressively higher (growth story)
// Card x-zones verified non-overlapping at container width 1440px

const stops = [
  { cx: 6,  cy: 74, side: 'right', w: '13rem' },
  { cx: 28, cy: 40, side: 'right', w: '16rem' },
  { cx: 52, cy: 62, side: 'left',  w: '18rem' },
  { cx: 74, cy: 26, side: 'left',  w: '16rem' },
  { cx: 92, cy: 48, side: 'left',  w: '15rem' },
];

// Mobile: vertical zigzag (same aesthetic, rotated portrait)
const mobileStops = [
  { cx: 26, cy: 8,  side: 'right' },
  { cx: 72, cy: 28, side: 'left'  },
  { cx: 26, cy: 50, side: 'right' },
  { cx: 72, cy: 72, side: 'left'  },
  { cx: 26, cy: 91, side: 'right' },
];

const briefs = [
  'B.Tech CS · systems foundation',
  'Realtime feeds, fraud & white-label',
  'Payments, search & A/B scale',
  'AI agents & MCP workflows',
  'Your hard problem, I\'m ready',
];
---

<section id="journey" class="career-section" aria-labelledby="career-title">
  <div class="career-heading fade-up">
    <p class="career-kicker mono">02 / EXPERIENCE</p>
    <h2 id="career-title">Experience in motion.</h2>
    <p>Fundamentals → realtime → consumer scale → AI agents → your call.</p>
  </div>

  <div class="career-river fade-up" aria-label="Experience chapters">
    <svg class="career-ray" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="careerRayGradient" x1="0%" x2="100%" y1="0%" y2="0%">
          <stop offset="0%"   stop-color="#ffb84d" />
          <stop offset="25%"  stop-color="#c77dff" />
          <stop offset="52%"  stop-color="#00d2ff" />
          <stop offset="76%"  stop-color="#23f6a5" />
          <stop offset="100%" stop-color="#ff4da6" />
        </linearGradient>
        <filter id="careerRayGlow" x="-5%" y="-400%" width="110%" height="900%">
          <feGaussianBlur stdDeviation="5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <!-- wide soft haze behind -->
      <path vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="22" stroke-linecap="round"
        opacity="0.05" filter="url(#careerRayGlow)"
        d="M6 74 C14 58 20 26 28 40 C36 54 42 74 52 62 C62 50 62 16 74 26 C84 36 83 57 92 48" />
      <!-- main thin line -->
      <path class="ray-flow" vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="1.5" stroke-linecap="round"
        opacity="0.75"
        d="M6 74 C14 58 20 26 28 40 C36 54 42 74 52 62 C62 50 62 16 74 26 C84 36 83 57 92 48" />
      <!-- animated spark dash -->
      <path class="ray-spark" vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="1" stroke-linecap="round"
        stroke-dasharray="3 14" opacity="0.95"
        d="M6 74 C14 58 20 26 28 40 C36 54 42 74 52 62 C62 50 62 16 74 26 C84 36 83 57 92 48" />
    </svg>

    <div class="career-aura" aria-hidden="true"></div>

    <!-- Mobile vertical zigzag path (shown ≤640px only) -->
    <svg class="career-ray-mob" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="mobGrad" x1="0%" x2="0%" y1="0%" y2="100%">
          <stop offset="0%"   stop-color="#ffb84d" />
          <stop offset="25%"  stop-color="#c77dff" />
          <stop offset="52%"  stop-color="#00d2ff" />
          <stop offset="76%"  stop-color="#23f6a5" />
          <stop offset="100%" stop-color="#ff4da6" />
        </linearGradient>
      </defs>
      <path vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#mobGrad)" stroke-width="22" stroke-linecap="round"
        opacity="0.05"
        d="M26 8 C8 15 92 22 72 28 C52 34 48 44 26 50 C8 56 92 64 72 72 C52 78 48 86 26 91" />
      <path vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#mobGrad)" stroke-width="1.5" stroke-linecap="round"
        opacity="0.75"
        d="M26 8 C8 15 92 22 72 28 C52 34 48 44 26 50 C8 56 92 64 72 72 C52 78 48 86 26 91" />
      <path class="ray-spark" vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#mobGrad)" stroke-width="1" stroke-linecap="round"
        stroke-dasharray="3 14" opacity="0.95"
        d="M26 8 C8 15 92 22 72 28 C52 34 48 44 26 50 C8 56 92 64 72 72 C52 78 48 86 26 91" />
    </svg>

    {journey.map((chapter, i) => {
      const s = stops[i];
      const ms = mobileStops[i];
      return (
        <button
          class={`chapter chapter--${s.side}`}
          style={`--cx:${s.cx}%;--cy:${s.cy}%;--mob-cx:${ms.cx}%;--mob-cy:${ms.cy}%;--w:${s.w};--accent:${chapter.accent};--i:${i};`}
          data-index={String(i)}
          data-dir={i % 2 === 0 ? 'below' : 'above'}
          data-mob-side={ms.side}
          aria-label={`${chapter.label} – click for full details`}
        >
          <span class="chapter-dot mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="chapter-card">
            <p class="chapter-status mono">{chapter.status}</p>
            <p class="chapter-name">{chapter.label}</p>
            <p class="chapter-brief mono">{briefs[i]}</p>
          </div>
        </button>
      );
    })}
  </div>

  <!-- Detail popover -->
  <div id="exp-pop" class="exp-pop" hidden role="tooltip">
    <button class="exp-pop-close mono" aria-label="Close">✕</button>
    <p class="exp-pop-status mono" id="exp-pop-status"></p>
    <h3 id="exp-pop-name"></h3>
    <strong id="exp-pop-title"></strong>
    <p id="exp-pop-line"></p>
    <div class="exp-pop-proof" id="exp-pop-proof"></div>
  </div>
</section>

<script define:vars={{ journey }}>
  const pop     = document.getElementById('exp-pop');
  // Move out of career-section to avoid overflow:clip clipping fixed children
  document.body.appendChild(pop);
  const pStatus = document.getElementById('exp-pop-status');
  const pName   = document.getElementById('exp-pop-name');
  const pTitle  = document.getElementById('exp-pop-title');
  const pLine   = document.getElementById('exp-pop-line');
  const pProof  = document.getElementById('exp-pop-proof');
  const GAP = 10; // px gap between button and popover

  function openPop(btn, idx) {
    const c = journey[idx];
    pStatus.textContent = c.status;
    pName.textContent   = c.label;
    pTitle.textContent  = c.title;
    pLine.textContent   = c.line;
    pProof.innerHTML    = c.proof.map(p => `<span class="pop-tag">${p}</span>`).join('');
    pop.style.setProperty('--accent', c.accent);
    pop.hidden = false;
    pop.dataset.active = idx;
    popOpenScrollY = window.scrollY;

    // Position after paint so we know pop dimensions
    requestAnimationFrame(() => {
      const br   = btn.getBoundingClientRect();
      const pw   = pop.offsetWidth;
      const ph   = pop.offsetHeight;
      const vw   = window.innerWidth;
      const vh   = window.innerHeight;

      // Horizontal: align left edge of pop to left edge of button, flip if overflows
      let left = br.left;
      if (left + pw > vw - 12) left = br.right - pw;
      left = Math.max(12, left);

      // Vertical: prefer below button, flip above if not enough room
      let top = br.bottom + GAP;
      if (top + ph > vh - 12) top = br.top - ph - GAP;
      top = Math.max(12, top);

      pop.style.left = `${left}px`;
      pop.style.top  = `${top}px`;

      requestAnimationFrame(() => pop.classList.add('is-open'));
    });
  }

  function closePop() {
    pop.classList.remove('is-open');
    pop.addEventListener('transitionend', () => {
      pop.hidden = true;
      delete pop.dataset.active;
    }, { once: true });
  }

  document.querySelectorAll('.chapter').forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.dataset.index);
      // Toggle: clicking the same dot again closes it
      if (!pop.hidden && pop.dataset.active === String(idx)) {
        closePop();
      } else {
        openPop(btn, idx);
      }
    });
  });

  document.querySelector('.exp-pop-close')?.addEventListener('click', closePop);

  // Close on outside click — but not when clicking a chapter button (that handler toggles)
  document.addEventListener('click', e => {
    if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.chapter')) closePop();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !pop.hidden) closePop();
  });

  // Close on scroll (>40px from where popover was opened)
  let popOpenScrollY = 0;
  window.addEventListener('scroll', () => {
    if (!pop.hidden && Math.abs(window.scrollY - popOpenScrollY) > 40) closePop();
  }, { passive: true });
</script>

<script>
  /* ── Photon: single glowing particle, origin → end → repeat ── */
  (function () {
    const river = document.querySelector('.career-river');
    if (!river || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* ── gradient color interpolation ── */
    const STOPS = [
      [0,    255,184, 77],
      [0.25, 199,125,255],
      [0.52,   0,210,255],
      [0.76,  35,246,165],
      [1,    255, 77,166],
    ];
    function colorAt(t) {
      let i = 0;
      while (i < STOPS.length - 1 && STOPS[i + 1][0] < t) i++;
      if (i >= STOPS.length - 1) { const s = STOPS[STOPS.length - 1]; return `rgb(${s[1]},${s[2]},${s[3]})`; }
      const a = STOPS[i], b = STOPS[i + 1], f = (t - a[0]) / (b[0] - a[0]);
      return `rgb(${a[1]+(b[1]-a[1])*f|0},${a[2]+(b[2]-a[2])*f|0},${a[3]+(b[3]-a[3])*f|0})`;
    }

    /* ── node positions for pulse bursts ── */
    const D_NODES = [[6,74],[28,40],[52,62],[74,26],[92,48]];
    const M_NODES = [[26,8],[72,28],[26,50],[72,72],[26,91]];

    function nearNode(px, py) {
      const nodes = mob ? M_NODES : D_NODES;
      for (const [nx, ny] of nodes) {
        const dx = px - nx, dy = py - ny;
        if (dx * dx + dy * dy < 18) return true;
      }
      return false;
    }

    /* ── DOM ── */
    const TRAIL = 5;
    const TRAIL_GAP = 0.018;           // spacing between trail dots (fraction of path)
    const SPEED = 0.000085;             // progress per ms (~12s per full journey)

    const wrap = document.createElement('div');
    wrap.className = 'photon-wrap';
    wrap.setAttribute('aria-hidden', 'true');
    river.appendChild(wrap);

    const lead = document.createElement('div');
    lead.className = 'photon photon--lead';
    wrap.appendChild(lead);

    const trails = [];
    for (let i = 0; i < TRAIL; i++) {
      const d = document.createElement('div');
      d.className = 'photon photon--trail';
      const decay = 1 - (i + 1) / (TRAIL + 1);
      d.style.opacity = String(decay * 0.78);
      d.style.setProperty('--s', String(decay));
      wrap.appendChild(d);
      trails.push(d);
    }
    const allEls = [lead, ...trails];

    /* ── layout cache (avoid measuring every frame) ── */
    let mob = false;
    let cw = 0, ch = 0;

    function measure() {
      mob = window.innerWidth <= 640;
      const r = river.getBoundingClientRect();
      cw = r.width;
      ch = r.height;
    }
    measure();
    window.addEventListener('resize', measure, { passive: true });

    function getPath() {
      const paths = document.querySelectorAll(mob ? '.career-ray-mob path' : '.career-ray path');
      return paths[1] || paths[0];
    }

    /* ── animation loop (transform-only, GPU composited) ── */
    let progress = 0;
    let prev = 0;

    function tick(now) {
      const dt = prev ? now - prev : 16;
      prev = now;

      const path = getPath();
      if (!path) { requestAnimationFrame(tick); return; }

      const len = path.getTotalLength();
      progress = (progress + SPEED * dt) % 1;

      for (let i = 0; i < allEls.length; i++) {
        let t = progress - i * TRAIL_GAP;
        // trail particles that haven't "spawned" yet stay hidden at origin
        if (t < 0) {
          allEls[i].style.opacity = '0';
          continue;
        }
        if (i > 0) allEls[i].style.opacity = String((1 - (i / (TRAIL + 1))) * 0.78);

        const pt = path.getPointAtLength(t * len);
        // viewBox 0-100 → pixel position inside the container
        const px = (pt.x / 100) * cw;
        const py = (pt.y / 100) * ch;

        allEls[i].style.transform = `translate(${px}px, ${py}px) translate(-50%, -50%)`;
        allEls[i].style.setProperty('--pc', colorAt(t));

        if (i === 0) {
          lead.classList.toggle('photon--pulse', nearNode(pt.x, pt.y));
        }
      }

      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  })();
</script>

<style>
  /* ── Section shell ────────────────────────────────── */
  .career-section {
    position: relative;
    z-index: 10;
    padding: clamp(5.5rem, 7vw, 7rem) var(--page-pad);
    color: #fff;
    overflow: clip;
  }

  .career-section::before {
    content: "";
    position: absolute;
    inset: 6% -14% auto;
    height: min(620px, 62vw);
    background:
      radial-gradient(circle at 24% 28%, rgba(0,210,255,0.08), transparent 24rem),
      radial-gradient(circle at 78% 30%, rgba(255,77,166,0.08), transparent 24rem),
      radial-gradient(circle at 48% 78%, rgba(35,246,165,0.07), transparent 20rem);
    pointer-events: none;
  }

  /* ── Heading ──────────────────────────────────────── */
  .career-heading {
    position: relative;
    max-width: 1440px;
    margin: 0 auto clamp(1.3rem, 2.5vw, 2rem);
  }

  .career-kicker {
    margin: 0 0 0.9rem;
    color: var(--nebula-accent);
    font-size: var(--fs-sm);
    letter-spacing: 0.18em;
  }

  .career-heading h2 {
    max-width: 1040px;
    margin: 0;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: var(--fs-2xl);
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .career-heading p {
    max-width: 850px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  /* ── River canvas ─────────────────────────────────── */
  .career-river {
    position: relative;
    max-width: 1440px;
    min-height: clamp(580px, 45vw, 720px);
    margin: 0 auto;
    overflow: clip;
    isolation: isolate;
  }

  .career-river::before {
    content: "";
    position: absolute;
    inset: 4% 0 8%;
    z-index: -2;
    background:
      linear-gradient(rgba(255,255,255,0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.032) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 72% at 50% 48%, black, transparent 100%);
    opacity: 0.55;
  }

  .career-aura {
    position: absolute;
    inset: 8% 6%;
    z-index: -1;
    background: conic-gradient(from 130deg at 47% 50%,
      transparent, rgba(0,210,255,0.08), rgba(199,125,255,0.1), rgba(35,246,165,0.08), transparent);
    filter: blur(28px);
    opacity: 0.7;
    animation: aura-shift 11s ease-in-out infinite alternate;
  }

  @keyframes aura-shift {
    to { transform: scale(1.04) rotate(2deg); filter: blur(34px) hue-rotate(18deg); }
  }

  /* ── SVG rail ─────────────────────────────────────── */
  .career-ray {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .ray-spark {
    animation: ray-spark 4.8s linear infinite;
  }

  @keyframes ray-spark {
    to { stroke-dashoffset: -80; }
  }

  /* ── Chapter buttons ──────────────────────────────── */
  /*
   * stops[i].cx / cy are SVG viewBox coords (0-100).
   * Since viewBox="0 0 100 100" + preserveAspectRatio="none",
   * SVG x=N maps to CSS left=N%, SVG y=N maps to CSS top=N%.
   * Dot half-width = 1.5rem (dot is 3rem wide).
   * chapter--right: translate(-1.5rem, calc(-100% + 1.5rem)) → dot center at (cx%, cy%), card floats ABOVE
   * chapter--left:  translate(calc(-100% + 1.5rem), -1.5rem) → dot center at (cx%, cy%), card floats BELOW
   */
  .chapter {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    z-index: 4;
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    width: fit-content;
    max-width: min(var(--w), 28vw);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    animation: chapter-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }

  /* Mobile zigzag SVG — hidden by default */
  .career-ray-mob {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  /* dot on path, card BELOW — left-edge cards (01, 03, 05) */
  .chapter--right[data-dir="below"] {
    flex-direction: column;
    align-items: flex-start;
    transform: translate(-1.5rem, -1.5rem);
    text-align: left;
  }

  /* dot on path, card ABOVE — left-edge cards (02) */
  .chapter--right[data-dir="above"] {
    flex-direction: column-reverse;
    align-items: flex-start;
    transform: translate(-1.5rem, calc(-100% + 1.5rem));
    text-align: left;
  }

  /* dot on path, card BELOW — right-edge cards (03, 05) */
  .chapter--left[data-dir="below"] {
    flex-direction: column;
    align-items: flex-end;
    transform: translate(calc(-100% + 1.5rem), -1.5rem);
    text-align: right;
  }

  /* dot on path, card ABOVE — right-edge cards (04) */
  .chapter--left[data-dir="above"] {
    flex-direction: column-reverse;
    align-items: flex-end;
    transform: translate(calc(-100% + 1.5rem), calc(-100% + 1.5rem));
    text-align: right;
  }

  @keyframes chapter-float {
    50% { translate: 0 -6px; }
  }

  /* ── Dot ──────────────────────────────────────────── */
  .chapter-dot {
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    color: var(--accent);
    font-size: var(--fs-xs);
    letter-spacing: 0;
    position: relative;
    background: color-mix(in srgb, var(--accent) 10%, rgba(5,0,10,0.55));
    border: 1px solid color-mix(in srgb, var(--accent) 52%, rgba(255,255,255,0.12));
    box-shadow:
      0 0 14px color-mix(in srgb, var(--accent) 28%, transparent),
      inset 0 0 18px color-mix(in srgb, var(--accent) 8%, transparent);
    transition: transform 0.32s ease, box-shadow 0.32s ease;
  }

  .chapter-dot::before {
    content: "";
    position: absolute;
    inset: -0.52rem;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--accent) 32%, transparent);
    animation: dot-ring-spin 14s linear infinite;
  }

  .chapter-dot::after {
    content: "";
    position: absolute;
    inset: -0.82rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    animation: dot-ring-spin 20s linear infinite reverse;
  }

  @keyframes dot-ring-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .chapter:hover .chapter-dot,
  .chapter:focus-visible .chapter-dot {
    transform: scale(1.12);
    box-shadow:
      0 0 26px color-mix(in srgb, var(--accent) 52%, transparent),
      inset 0 0 22px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* ── Compact card ─────────────────────────────────── */
  .chapter-card {
    min-width: 0;
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 16%, rgba(255,255,255,0.07));
    background: color-mix(in srgb, var(--accent) 5%, rgba(5,0,10,0.55));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: border-color 0.22s ease, background 0.22s ease;
  }

  .chapter:hover .chapter-card {
    border-color: color-mix(in srgb, var(--accent) 38%, rgba(255,255,255,0.1));
    background: color-mix(in srgb, var(--accent) 10%, rgba(5,0,10,0.65));
  }

  .chapter-status {
    margin: 0 0 0.2rem;
    color: var(--accent);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .chapter-name {
    margin: 0;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.2;
  }

  .chapter-brief {
    margin: 0.2rem 0 0;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-2xs);
    line-height: 1.4;
  }

  /* ── Popover ─────────────────────────────────────── */
  .exp-pop {
    position: fixed;
    z-index: 200;
    width: 280px;
    padding: 1.1rem 1.2rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--accent, #00d2ff) 30%, rgba(255,255,255,0.1));
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent, #00d2ff) 10%, transparent), transparent 10rem),
      rgba(6,1,16,0.92);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    box-shadow:
      0 8px 32px rgba(0,0,0,0.45),
      0 0 40px color-mix(in srgb, var(--accent, #00d2ff) 8%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.08);
    opacity: 0;
    scale: 0.95;
    transition: opacity 0.16s ease, scale 0.16s ease;
    pointer-events: none;
  }

