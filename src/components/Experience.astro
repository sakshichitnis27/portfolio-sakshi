---
import { journey } from '../data/portfolio';

// SVG path: M5 72 C17 54 21 25 35 31 C49 37 43 68 57 58 C70 49 67 18 80 24 C92 30 86 68 96 63
// stops[i].cx / cy  === on-curve bezier endpoints in SVG viewBox-100 space
// Because preserveAspectRatio="none" and viewBox 0 0 100 100:
//   SVG x=5 == CSS left=5%,  SVG y=72 == CSS top=72%
// dot width = 3rem => half = 1.5rem used in the translate math

const stops = [
  { cx: 5,  cy: 72, side: 'right', w: '14rem' },
  { cx: 35, cy: 31, side: 'right', w: '16rem' },
  { cx: 57, cy: 58, side: 'left',  w: '18rem' },
  { cx: 74, cy: 22, side: 'left',  w: '16rem' },
  { cx: 88, cy: 66, side: 'left',  w: '15rem' },
];

const briefs = [
  'B.Tech CS · systems foundation',
  'Realtime feeds & fraud paths',
  'Payments, DB, Search & LLM',
  'AI agents & MCP workflows',
  'Next: your hard problem',
];
---

<section id="journey" class="career-section" aria-labelledby="career-title">
  <div class="career-heading fade-up">
    <p class="career-kicker mono">02 / EXPERIENCE</p>
    <h2 id="career-title">Experience in motion.</h2>
    <div class="career-path-label mono" aria-label="Career path">
      <span>Medicaps</span><i></i>
      <span>Gammastack</span><i></i>
      <span>Pocket FM</span><i></i>
      <span>AI agents</span><i></i>
      <span>Your call</span>
    </div>
    <p>Fundamentals → realtime → consumer scale → AI agents → your call.</p>
  </div>

  <div class="career-river fade-up" aria-label="Experience chapters">
    <svg class="career-ray" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="careerRayGradient" x1="0%" x2="100%" y1="0%" y2="0%">
          <stop offset="0%"   stop-color="#ffb84d" />
          <stop offset="25%"  stop-color="#c77dff" />
          <stop offset="52%"  stop-color="#00d2ff" />
          <stop offset="76%"  stop-color="#23f6a5" />
          <stop offset="100%" stop-color="#ff4da6" />
        </linearGradient>
        <filter id="careerRayGlow" x="-5%" y="-400%" width="110%" height="900%">
          <feGaussianBlur stdDeviation="5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <!-- wide soft haze behind -->
      <path vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="22" stroke-linecap="round"
        opacity="0.05" filter="url(#careerRayGlow)"
        d="M5 72 C17 54 21 25 35 31 C49 37 43 68 57 58 C66 46 63 16 74 22 C84 28 80 62 88 66" />
      <!-- main thin line -->
      <path class="ray-flow" vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="1.5" stroke-linecap="round"
        opacity="0.75"
        d="M5 72 C17 54 21 25 35 31 C49 37 43 68 57 58 C66 46 63 16 74 22 C84 28 80 62 88 66" />
      <!-- animated spark dash -->
      <path class="ray-spark" vector-effect="non-scaling-stroke" fill="none"
        stroke="url(#careerRayGradient)" stroke-width="1" stroke-linecap="round"
        stroke-dasharray="3 14" opacity="0.95"
        d="M5 72 C17 54 21 25 35 31 C49 37 43 68 57 58 C66 46 63 16 74 22 C84 28 80 62 88 66" />
    </svg>

    <div class="career-aura" aria-hidden="true"></div>

    {journey.map((chapter, i) => {
      const s = stops[i];
      return (
        <button
          class={`chapter chapter--${s.side}`}
          style={`left:${s.cx}%;top:${s.cy}%;--w:${s.w};--accent:${chapter.accent};--i:${i};`}
          data-index={String(i)}
          aria-label={`${chapter.label} – click for full details`}
        >
          <span class="chapter-dot mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="chapter-card">
            <p class="chapter-status mono">{chapter.status}</p>
            <p class="chapter-name">{chapter.label}</p>
            <p class="chapter-brief mono">{briefs[i]}</p>
          </div>
        </button>
      );
    })}
  </div>

  <!-- Detail modal -->
  <div id="exp-modal" class="exp-modal" role="dialog" aria-modal="true" aria-labelledby="exp-modal-name" hidden>
    <div class="exp-modal-backdrop"></div>
    <div class="exp-modal-box">
      <button class="exp-modal-close mono" aria-label="Close details">✕</button>
      <p class="exp-modal-status mono" id="exp-modal-status"></p>
      <h3 id="exp-modal-name"></h3>
      <strong id="exp-modal-title"></strong>
      <p id="exp-modal-line"></p>
      <div class="exp-modal-proof" id="exp-modal-proof"></div>
    </div>
  </div>
</section>

<script define:vars={{ journey }}>
  const modal   = document.getElementById('exp-modal');
  const mStatus = document.getElementById('exp-modal-status');
  const mName   = document.getElementById('exp-modal-name');
  const mTitle  = document.getElementById('exp-modal-title');
  const mLine   = document.getElementById('exp-modal-line');
  const mProof  = document.getElementById('exp-modal-proof');

  function openModal(idx) {
    const c = journey[idx];
    mStatus.textContent = c.status;
    mName.textContent   = c.label;
    mTitle.textContent  = c.title;
    mLine.textContent   = c.line;
    mProof.innerHTML    = c.proof.map(p => `<span>${p}</span>`).join('');
    modal.style.setProperty('--accent', c.accent);
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => modal.classList.add('is-open'));
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.addEventListener('transitionend', () => {
      modal.hidden = true;
      document.body.style.overflow = '';
    }, { once: true });
  }

  document.querySelectorAll('.chapter').forEach(btn => {
    btn.addEventListener('click', () => openModal(Number(btn.dataset.index)));
  });
  document.querySelector('.exp-modal-backdrop')?.addEventListener('click', closeModal);
  document.querySelector('.exp-modal-close')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !modal?.hidden) closeModal();
  });
</script>

<style>
  /* ── Section shell ────────────────────────────────── */
  .career-section {
    position: relative;
    z-index: 10;
    padding: clamp(5.5rem, 7vw, 7rem) var(--page-pad);
    color: #fff;
    overflow: clip;
  }

  .career-section::before {
    content: "";
    position: absolute;
    inset: 6% -14% auto;
    height: min(620px, 62vw);
    background:
      radial-gradient(circle at 24% 28%, rgba(0,210,255,0.08), transparent 24rem),
      radial-gradient(circle at 78% 30%, rgba(255,77,166,0.08), transparent 24rem),
      radial-gradient(circle at 48% 78%, rgba(35,246,165,0.07), transparent 20rem);
    pointer-events: none;
  }

  /* ── Heading ──────────────────────────────────────── */
  .career-heading {
    position: relative;
    max-width: 1440px;
    margin: 0 auto clamp(1.3rem, 2.5vw, 2rem);
  }

  .career-kicker {
    margin: 0 0 0.9rem;
    color: var(--nebula-accent);
    font-size: var(--fs-sm);
    letter-spacing: 0.18em;
  }

  .career-heading h2 {
    max-width: 1040px;
    margin: 0;
    font-size: var(--fs-2xl);
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .career-heading h2::first-letter {
    color: var(--nebula-accent);
  }

  .career-heading p {
    max-width: 850px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .career-path-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    max-width: 980px;
    margin-top: 1rem;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-xs);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .career-path-label span:nth-of-type(3) { color: var(--nebula-accent); }

  .career-path-label i {
    flex: 0 0 clamp(1.3rem, 3.5vw, 3.2rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--nebula-accent), transparent);
    box-shadow: 0 0 14px rgba(0,210,255,0.35);
  }

  /* ── River canvas ─────────────────────────────────── */
  .career-river {
    position: relative;
    max-width: 1440px;
    min-height: clamp(580px, 45vw, 720px);
    margin: 0 auto;
    overflow: clip;
    isolation: isolate;
  }

  .career-river::before {
    content: "";
    position: absolute;
    inset: 4% 0 8%;
    z-index: -2;
    background:
      linear-gradient(rgba(255,255,255,0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.032) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 50% 48%, black, transparent 76%);
    opacity: 0.65;
  }

  .career-aura {
    position: absolute;
    inset: 8% 6%;
    z-index: -1;
    background: conic-gradient(from 130deg at 47% 50%,
      transparent, rgba(0,210,255,0.08), rgba(199,125,255,0.1), rgba(35,246,165,0.08), transparent);
    filter: blur(28px);
    opacity: 0.7;
    animation: aura-shift 11s ease-in-out infinite alternate;
  }

  @keyframes aura-shift {
    to { transform: scale(1.04) rotate(2deg); filter: blur(34px) hue-rotate(18deg); }
  }

  /* ── SVG rail ─────────────────────────────────────── */
  .career-ray {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .ray-spark {
    animation: ray-spark 4.8s linear infinite;
  }

  @keyframes ray-spark {
    to { stroke-dashoffset: -80; }
  }

  /* ── Chapter buttons ──────────────────────────────── */
  /*
   * stops[i].cx / cy are SVG viewBox coords (0-100).
   * Since viewBox="0 0 100 100" + preserveAspectRatio="none",
   * SVG x=N maps to CSS left=N%, SVG y=N maps to CSS top=N%.
   * Dot half-width = 1.5rem (dot is 3rem wide).
   * chapter--right: translate(-1.5rem, -50%)  → dot center at (cx%, cy%)
   * chapter--left:  translate(calc(-100% + 1.5rem), -50%) → dot center at (cx%, cy%)
   */
  .chapter {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    max-width: min(var(--w), 28vw);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    animation: chapter-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }

  .chapter--right {
    /* dot (first child) center lands on (cx%, cy%) */
    transform: translate(-1.5rem, -50%);
    flex-direction: row;
    text-align: left;
  }

  .chapter--left {
    /* dot (first child, reversed visually) center lands on (cx%, cy%) */
    transform: translate(calc(-100% + 1.5rem), -50%);
    flex-direction: row-reverse;
    text-align: right;
  }

  @keyframes chapter-float {
    50% { translate: 0 -6px; }
  }

  /* ── Dot ──────────────────────────────────────────── */
  .chapter-dot {
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, rgba(5,0,10,0.3));
    border: 1px solid color-mix(in srgb, var(--accent) 38%, rgba(255,255,255,0.08));
    box-shadow:
      0 0 12px color-mix(in srgb, var(--accent) 26%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.1);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: var(--fs-xs);
    letter-spacing: 0;
    position: relative;
    animation: dot-hue-shift 10s linear infinite;
    animation-delay: calc(var(--i) * -2s);
    transition: box-shadow 0.24s ease, transform 0.24s ease;
  }

  @keyframes dot-hue-shift {
    to { filter: hue-rotate(360deg); }
  }

  .chapter-dot::after {
    content: "";
    position: absolute;
    inset: -0.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    animation: dot-ring-pulse 3s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }

  @keyframes dot-ring-pulse {
    0%, 100% { transform: scale(1);   opacity: 0.5; }
    50%       { transform: scale(1.4); opacity: 0; }
  }

  .chapter:hover .chapter-dot {
    box-shadow:
      0 0 24px color-mix(in srgb, var(--accent) 55%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.14);
    transform: scale(1.12);
  }

  /* ── Compact card ─────────────────────────────────── */
  .chapter-card {
    min-width: 0;
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 16%, rgba(255,255,255,0.07));
    background: color-mix(in srgb, var(--accent) 5%, rgba(5,0,10,0.55));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: border-color 0.22s ease, background 0.22s ease;
  }

  .chapter:hover .chapter-card {
    border-color: color-mix(in srgb, var(--accent) 38%, rgba(255,255,255,0.1));
    background: color-mix(in srgb, var(--accent) 10%, rgba(5,0,10,0.65));
  }

  .chapter-status {
    margin: 0 0 0.2rem;
    color: var(--accent);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .chapter-name {
    margin: 0;
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.2;
  }

  .chapter-brief {
    margin: 0.2rem 0 0;
    color: rgba(255,255,255,0.6);
    font-size: var(--fs-2xs);
    line-height: 1.4;
  }

  /* ── Modal ────────────────────────────────────────── */
  .exp-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .exp-modal.is-open {
    opacity: 1;
  }

  .exp-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2,0,8,0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .exp-modal-box {
    position: relative;
    z-index: 1;
    width: min(520px, 90vw);
    padding: 2.2rem 2rem 2rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--accent, #00d2ff) 35%, rgba(255,255,255,0.1));
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent, #00d2ff) 14%, transparent), transparent 14rem),
      rgba(6,1,16,0.88);
    -webkit-backdrop-filter: blur(28px);
    backdrop-filter: blur(28px);
    box-shadow:
      0 0 80px color-mix(in srgb, var(--accent, #00d2ff) 12%, transparent),
      0 32px 80px rgba(0,0,0,0.5),
      inset 0 1px 0 rgba(255,255,255,0.1);
    transform: translateY(12px);
    transition: transform 0.32s cubic-bezier(0.34,1.56,0.64,1);
  }

  .exp-modal.is-open .exp-modal-box {
    transform: translateY(0);
  }

  .exp-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.7);
    font-size: var(--fs-xs);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .exp-modal-close:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
  }

  .exp-modal-status {
    margin: 0 0 0.6rem;
    color: var(--accent, #00d2ff);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .exp-modal-box h3 {
    margin: 0;
    font-size: var(--fs-xl);
    line-height: 0.96;
    color: #fff;
  }

  .exp-modal-box strong {
    display: block;
    margin-top: 0.75rem;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-base);
    line-height: 1.3;
  }

  .exp-modal-box p:last-of-type {
    margin: 0.7rem 0 0;
    color: rgba(255,255,255,0.78);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .exp-modal-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  .exp-modal-proof span {
    border: 1px solid color-mix(in srgb, var(--accent, #00d2ff) 30%, rgba(255,255,255,0.12));
    border-radius: 999px;
    padding: 0.38rem 0.62rem;
    color: #fff;
    background: color-mix(in srgb, var(--accent, #00d2ff) 10%, rgba(255,255,255,0.04));
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-2xs);
    line-height: 1;
  }

  /* ── Tablet / mobile ──────────────────────────────── */
  @media (max-width: 1100px) {
    .career-river {
      min-height: auto;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      padding: 1.1rem 0;
      overflow: visible;
    }

    .career-ray { display: none; }
    .career-aura { inset: 0; }

    /* vertical line on mobile */
    .career-river::after {
      content: "";
      position: absolute;
      left: 1.3rem;
      top: 0.5rem;
      bottom: 0.5rem;
      z-index: 1;
      width: 2px;
      border-radius: 999px;
      background: linear-gradient(180deg, #ffb84d, #c77dff, #00d2ff, #23f6a5, #ff4da6);
      box-shadow: 0 0 18px rgba(0,210,255,0.4), 0 0 42px rgba(199,125,255,0.22);
      opacity: 0.85;
    }

    .chapter,
    .chapter--right,
    .chapter--left {
      position: relative;
      left: auto !important;
      top: auto !important;
      transform: none;
      flex-direction: row;
      text-align: left;
      max-width: 100%;
      width: auto;
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .career-section {
      padding: 3.4rem var(--page-pad) 6rem;
    }

    .career-heading h2 {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .career-path-label,
    .career-heading p { display: none; }

    .chapter-dot {
      flex: 0 0 2.5rem;
      width: 2.5rem;
      height: 2.5rem;
      font-size: var(--fs-2xs);
    }

    .exp-modal-box {
      padding: 1.6rem 1.25rem 1.5rem;
    }

    .exp-modal-box h3 {
      font-size: clamp(1.8rem, 7vw, 2.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-aura, .ray-spark, .chapter,
    .chapter-dot, .chapter-dot::after { animation: none !important; }
    .exp-modal, .exp-modal-box { transition: none !important; }
  }
</style>
