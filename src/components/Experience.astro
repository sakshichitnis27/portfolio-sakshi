---
import { journey } from '../data/portfolio';
---

<section id="journey" class="journey-section" aria-labelledby="journey-title">
  <div class="journey-heading fade-up">
    <p class="journey-kicker mono">02 / SIGNAL PATH</p>
    <h2 id="journey-title">Career <span>signal path.</span></h2>
    <p class="journey-sub">A compact path from systems foundation to revenue scale, quiet AI agent builds, and the next serious problem.</p>
  </div>

  <div class="journey-map fade-up" aria-label="Career signal path">
    <svg class="journey-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="journeyGlow" x1="0%" x2="100%" y1="0%" y2="100%">
          <stop offset="0%" stop-color="#ffb84d" />
          <stop offset="25%" stop-color="#c77dff" />
          <stop offset="52%" stop-color="#00d2ff" />
          <stop offset="75%" stop-color="#23f6a5" />
          <stop offset="100%" stop-color="#ff4da6" />
        </linearGradient>
      </defs>
      <path class="journey-path-base" d="M7 35 C 21 72, 30 74, 42 38 S 66 18, 76 61 S 91 59, 96 31" />
      <path class="journey-path-flow" d="M7 35 C 21 72, 30 74, 42 38 S 66 18, 76 61 S 91 59, 96 31" />
    </svg>

    {journey.map((item, index) => (
      <article
        class="journey-card"
        style={`--accent:${item.accent};--i:${index};`}
      >
        <div class="journey-card-top">
          <span class="journey-index mono">{String(index + 1).padStart(2, '0')}</span>
          <p class="journey-status mono">{item.status}</p>
        </div>
        <div class="journey-body">
          <h3>{item.label}</h3>
          <strong>{item.title}</strong>
          <p>{item.line}</p>
          <div class="journey-proof" aria-label={`${item.label} proof`}>
            {item.proof.map((proof) => <span>{proof}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    z-index: 10;
    padding: clamp(5.5rem, 7vw, 7rem) var(--page-pad) clamp(5.5rem, 7vw, 6.5rem);
    color: #fff;
    overflow: clip;
  }

  .journey-section::before {
    content: "";
    position: absolute;
    inset: 10% -18% auto;
    height: min(520px, 56vw);
    background:
      radial-gradient(circle at 18% 30%, rgba(0,210,255,0.08), transparent 24rem),
      radial-gradient(circle at 72% 18%, rgba(199,125,255,0.12), transparent 24rem),
      radial-gradient(circle at 46% 82%, rgba(255,77,166,0.08), transparent 18rem);
    pointer-events: none;
  }

  .journey-heading {
    max-width: 1280px;
    margin: 0 auto clamp(1.4rem, 3vw, 2.2rem);
  }

  .journey-kicker {
    margin: 0 0 0.9rem;
    color: var(--nebula-accent);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
  }

  .journey-heading h2 {
    max-width: 980px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.8rem, 5vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .journey-heading h2 span {
    display: block;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .journey-sub {
    max-width: 780px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.9);
    font-size: clamp(0.98rem, 1.25vw, 1.12rem);
    line-height: 1.65;
  }

  .journey-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    gap: clamp(0.7rem, 1vw, 1rem);
    max-width: 1400px;
    min-height: clamp(500px, 39vw, 590px);
    margin: 0 auto;
    padding: clamp(1rem, 1.4vw, 1.35rem);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px),
      radial-gradient(circle at 52% 50%, rgba(199,125,255,0.13), transparent 28rem),
      rgba(5,0,10,0.34);
    background-size: 48px 48px, 48px 48px, auto, auto;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), 0 30px 100px rgba(0,0,0,0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .journey-line {
    position: absolute;
    inset: 9% 2.6%;
    width: 94%;
    height: 82%;
    overflow: visible;
    pointer-events: none;
    filter: drop-shadow(0 0 18px rgba(0,210,255,0.32));
  }

  .journey-line path {
    fill: none;
    stroke: url(#journeyGlow);
    stroke-linecap: round;
  }

  .journey-path-base {
    stroke-width: 0.5;
    opacity: 0.32;
    filter: drop-shadow(0 0 14px rgba(199,125,255,0.24));
  }

  .journey-path-flow {
    stroke-width: 0.7;
    stroke-dasharray: 5 9;
    opacity: 0.72;
    filter: drop-shadow(0 0 22px rgba(0,210,255,0.54));
    animation: signal-flow 5.5s linear infinite;
  }

  @keyframes signal-flow {
    to { stroke-dashoffset: -120; }
  }

  .journey-card {
    position: relative;
    z-index: 2;
    width: 100%;
    min-height: clamp(230px, 20vw, 275px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.6rem;
    padding: clamp(1.05rem, 1.2vw, 1.25rem) clamp(1.15rem, 1.6vw, 1.55rem);
    border: 0;
    border-radius: 0;
    clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%);
    background: transparent;
    color: #fff;
    filter: drop-shadow(0 20px 58px rgba(0,0,0,0.34)) drop-shadow(0 0 26px color-mix(in srgb, var(--accent) 12%, transparent));
    isolation: isolate;
    overflow: hidden;
    transition: transform 0.28s ease, filter 0.28s ease;
    animation: card-float 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.45s);
  }

  .journey-card::before,
  .journey-card::after {
    content: "";
    position: absolute;
    clip-path: inherit;
    pointer-events: none;
  }

  .journey-card::before {
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 72%, white), rgba(255,255,255,0.18) 42%, color-mix(in srgb, var(--accent) 48%, transparent));
  }

  .journey-card::after {
    inset: 1px;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 11rem),
      linear-gradient(145deg, rgba(255,255,255,0.075), rgba(255,255,255,0.02)),
      rgba(7,1,14,0.74);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .journey-card > * {
    position: relative;
    z-index: 1;
  }

  .journey-card:hover {
    transform: translateY(-8px) scale(1.025);
    filter: drop-shadow(0 24px 76px rgba(0,0,0,0.38)) drop-shadow(0 0 48px color-mix(in srgb, var(--accent) 24%, transparent));
  }

  @keyframes card-float {
    50% { translate: 0 -7px; }
  }

  .journey-card:nth-of-type(1) { align-self: start; margin-top: 1.8rem; }
  .journey-card:nth-of-type(2) { align-self: end; margin-bottom: 1.2rem; }
  .journey-card:nth-of-type(3) { align-self: start; min-height: clamp(265px, 22vw, 310px); }
  .journey-card:nth-of-type(4) { align-self: end; margin-bottom: 1.55rem; }
  .journey-card:nth-of-type(5) { align-self: start; margin-top: 2.15rem; }

  .journey-card-top {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    min-width: 0;
  }

  .journey-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, rgba(255,255,255,0.18));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, rgba(255,255,255,0.04));
    color: var(--accent);
    font-size: 0.58rem;
    letter-spacing: 0;
  }

  .journey-status {
    min-width: 0;
    margin: 0;
    color: var(--accent);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .journey-body {
    margin-top: auto;
  }

  .journey-card h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.25rem, 1.9vw, 2rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .journey-card strong {
    display: block;
    margin-top: 0.8rem;
    color: #fff;
    font-size: 0.98rem;
    line-height: 1.2;
  }

  .journey-card p:not(.journey-status) {
    margin: 0.65rem 0 0;
    color: rgba(255,255,255,0.86);
    font-size: 0.9rem;
    line-height: 1.48;
  }

  .journey-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .journey-proof span {
    border: 1px solid color-mix(in srgb, var(--accent) 32%, rgba(255,255,255,0.14));
    border-radius: 999px;
    padding: 0.36rem 0.54rem;
    color: #fff;
    background: color-mix(in srgb, var(--accent) 10%, rgba(255,255,255,0.05));
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    line-height: 1;
  }

  @media (max-width: 1180px) {
    .journey-map {
      min-height: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      padding: 1rem;
    }

    .journey-line {
      display: none;
    }

    .journey-card,
    .journey-card:nth-of-type(n) {
      position: relative;
      inset: auto;
      width: auto;
      margin: 0;
      min-height: 260px;
    }

    .journey-card:nth-of-type(3) {
      grid-column: 1 / -1;
      min-height: 280px;
    }
  }

  @media (max-width: 640px) {
    .journey-section {
      padding: 5rem var(--page-pad);
    }

    .journey-heading h2 {
      font-size: clamp(2.45rem, 11.5vw, 3.6rem);
    }

    .journey-map {
      grid-template-columns: 1fr;
    }

    .journey-card:nth-of-type(3) {
      grid-column: auto;
    }

    .journey-card {
      clip-path: none;
      border-radius: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-line path,
    .journey-card {
      animation: none !important;
    }
  }
</style>
