---
import { projects } from '../data/portfolio';

const accents = ['#00d2ff', '#23f6a5'];
---

<section id="lab" class="lab-section" aria-labelledby="lab-title">
  <div class="lab-container">
    <div class="lab-heading fade-up">
      <p class="lab-kicker mono">04 / LAB</p>
      <h2 id="lab-title">Build lab.</h2>
      <p>Two public builds. Real constraints. No resume filler.</p>
    </div>

    <div class="lab-grid fade-up" aria-label="Personal projects">
      <div class="lab-beam" aria-hidden="true"></div>

      {/* Featured card – left 60% */}
      <a
        class="lab-card lab-card--feature"
        href={projects[0].href}
        target="_blank"
        rel="noopener noreferrer"
        style={`--accent:${accents[0]};--i:0;`}
        data-cursor
      >
        <div class="lab-card-head">
          <span class="mono">01</span>
          <p class="mono">{projects[0].kind}</p>
        </div>
        <h3>{projects[0].title}</h3>
        <p class="lab-description">{projects[0].description}</p>
        <div class="lab-proof">
          {projects[0].proof.map((item) => <span>{item}</span>)}
        </div>
        <div class="lab-stack" aria-label={`${projects[0].title} stack`}>
          {projects[0].stack.map((item) => <span>{item}</span>)}
        </div>
        <div class="lab-cta" aria-hidden="true">
          <span>View source</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>

      {/* Secondary card – right 40% */}
      <a
        class="lab-card lab-card--secondary"
        href={projects[1].href}
        target="_blank"
        rel="noopener noreferrer"
        style={`--accent:${accents[1]};--i:1;`}
        data-cursor
      >
        <div class="lab-card-head">
          <span class="mono">02</span>
          <p class="mono">{projects[1].kind}</p>
        </div>
        <h3>{projects[1].title}</h3>
        <p class="lab-description">{projects[1].description}</p>
        <div class="lab-proof">
          {projects[1].proof.map((item) => <span>{item}</span>)}
        </div>
        <div class="lab-stack" aria-label={`${projects[1].title} stack`}>
          {projects[1].stack.map((item) => <span>{item}</span>)}
        </div>
        <div class="lab-cta" aria-hidden="true">
          <span>View source</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .lab-section {
    position: relative;
    z-index: 10;
    padding: clamp(5rem, 6vw, 6.5rem) var(--page-pad);
    color: #fff;
    overflow: clip;
  }

  .lab-section::before {
    content: "";
    position: absolute;
    inset: 10% -14% auto;
    height: min(520px, 52vw);
    background:
      radial-gradient(circle at 22% 35%, rgba(0,210,255,0.1), transparent 20rem),
      radial-gradient(circle at 72% 45%, rgba(35,246,165,0.11), transparent 22rem),
      radial-gradient(circle at 48% 80%, rgba(199,125,255,0.08), transparent 18rem);
    pointer-events: none;
  }

  .lab-container {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
  }

  .lab-heading {
    max-width: 900px;
    margin-bottom: clamp(1.2rem, 2.2vw, 1.8rem);
  }

  .lab-kicker {
    margin: 0 0 0.9rem;
    color: var(--amber);
    font-size: var(--fs-sm);
    letter-spacing: 0.18em;
  }

  .lab-heading h2 {
    margin: 0;
    font-size: var(--fs-2xl);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .lab-heading h2::first-letter {
    color: var(--nebula-accent);
  }

  .lab-heading p:last-child {
    max-width: 620px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .lab-grid {
    position: relative;
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(1rem, 2vw, 1.35rem);
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      radial-gradient(circle at 50% 50%, rgba(0,210,255,0.1), transparent 18rem),
      rgba(5,0,10,0.3);
    background-size: 46px 46px, 46px 46px, auto, auto;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), 0 30px 100px rgba(0,0,0,0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .lab-beam {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    z-index: 1;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--violet-light), var(--green), transparent);
    box-shadow: 0 0 30px rgba(0,210,255,0.35);
    transform: rotate(-4deg);
    opacity: 0.72;
    pointer-events: none;
  }

  .lab-card {
    position: relative;
    z-index: 2;
    min-height: 315px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.88rem;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, rgba(255,255,255,0.12));
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(circle at 16% 18%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 15rem),
      linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.028)),
      rgba(7,1,14,0.76);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.12),
      0 28px 90px rgba(0,0,0,0.3),
      0 0 44px color-mix(in srgb, var(--accent) 13%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .lab-card--secondary {
    transform: translateY(2rem);
  }

  .lab-card--secondary h3 {
    font-size: clamp(2rem, 3vw, 3.2rem);
  }

  .lab-card--secondary .lab-description {
    font-size: var(--fs-sm);
  }

  .lab-card:hover,
  .lab-card:focus-visible {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 58%, rgba(255,255,255,0.16));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.14),
      0 34px 110px rgba(0,0,0,0.34),
      0 0 64px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .lab-card--secondary:hover,
  .lab-card--secondary:focus-visible {
    transform: translateY(1.25rem);
  }

  .lab-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    color: var(--accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    opacity: 0.82;
    transition: opacity 0.2s, gap 0.2s;
  }

  .lab-card:hover .lab-cta,
  .lab-card:focus-visible .lab-cta {
    opacity: 1;
    gap: 0.6rem;
  }

  .lab-card-head {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    min-width: 0;
  }

  .lab-card-head span {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--accent) 62%, rgba(255,255,255,0.12));
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    font-size: var(--fs-2xs);
    letter-spacing: 0;
  }

  .lab-card-head p {
    min-width: 0;
    margin: 0;
    color: var(--accent);
    font-size: var(--fs-2xs);
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .lab-card h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.4rem, 4vw, 4.3rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .lab-description {
    max-width: 48rem;
    margin: 0;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-base);
    line-height: 1.55;
  }

  .lab-proof,
  .lab-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .lab-proof span {
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    padding: 0.42rem 0.62rem;
    color: #fff;
    background: rgba(255,255,255,0.052);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-2xs);
  }

  .lab-stack span {
    color: rgba(255,255,255,0.78);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-2xs);
  }

  .lab-stack span:not(:last-child)::after {
    content: "/";
    margin-left: 0.42rem;
    color: rgba(255,255,255,0.5);
  }

  @media (max-width: 920px) {
    .lab-grid {
      grid-template-columns: 1fr;
      padding: 0.85rem 0.85rem calc(4.8rem + env(safe-area-inset-bottom));
    }

    .lab-beam {
      top: 2rem;
      bottom: 2rem;
      left: 50%;
      right: auto;
      width: 2px;
      height: auto;
      transform: translateX(-50%);
    }

    .lab-card,
    .lab-card--secondary,
    .lab-card:hover,
    .lab-card:focus-visible,
    .lab-card--secondary:hover,
    .lab-card--secondary:focus-visible {
      min-height: auto;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .lab-heading h2 {
      font-size: clamp(2.8rem, 13vw, 4.4rem);
    }

    .lab-card {
      padding: 1.1rem;
    }

    .lab-card h3 {
      font-size: clamp(2.15rem, 9vw, 3rem);
    }

    .lab-description {
      font-size: var(--fs-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-card {
      transition: none !important;
    }
  }
</style>
