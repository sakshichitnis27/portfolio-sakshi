---
import { projects } from '../data/portfolio';

const labMeta = [
  {
    accent: '#ff4da6',
    accent2: '#c77dff',
    marker: '#ffb84d',
    nodeLabel: 'Portfolio',
    signal: 'Shader stack',
    mode: 'Portfolio system',
    stats: [
      { value: 'Astro', label: 'static shell' },
      { value: 'Three.js', label: '3D scene' },
      { value: 'GSAP', label: 'scroll motion' },
    ],
    nodeX: '24%',
    nodeY: '33%',
  },
  {
    accent: '#23f6a5',
    accent2: '#36f4ff',
    marker: '#23f6a5',
    nodeLabel: 'HotDrop',
    signal: 'Device transfer',
    mode: 'Local-first app',
    stats: [
      { value: 'LAN', label: 'no cloud hop' },
      { value: 'QR', label: 'session pairing' },
      { value: 'Desktop', label: 'macOS flow' },
    ],
    nodeX: '76%',
    nodeY: '68%',
  },
] as const;

const labProjects = projects.slice(0, 2).map((project, index) => ({
  ...project,
  ...labMeta[index],
  number: String(index + 1).padStart(2, '0'),
}));
---

<section
  id="lab"
  class="lab-section"
  aria-labelledby="lab-title"
  data-lab-root
  style={`--active-accent:${labProjects[0].accent};--active-accent-2:${labProjects[0].accent2};`}
>
  <div class="lab-container">
    <div class="lab-heading fade-up">
      <p class="lab-kicker mono">04 / WORKBENCH</p>
      <h2 id="lab-title">Workbench.</h2>
      <p>Side projects built in public: two real systems wired as interactive workbench nodes instead of static cards.</p>
    </div>

    <div class="lab-shell fade-up" data-lab-stage>
      <div class="lab-field" aria-label="Project nodes">
        <div class="lab-scene" data-lab-scene aria-hidden="true">
          <canvas class="lab-canvas" data-lab-canvas></canvas>
          <div class="lab-scene-fallback"></div>
        </div>
        <div class="lab-field-grid" aria-hidden="true"></div>
        <div class="lab-axis lab-axis-x" aria-hidden="true"></div>
        <div class="lab-axis lab-axis-y" aria-hidden="true"></div>
        <div class="lab-scan" data-lab-scan aria-hidden="true"></div>

        <div class="lab-node-map">
          {labProjects.map((project, index) => (
            <button
              type="button"
              class={`lab-node ${index === 0 ? 'is-active' : ''}`}
              data-lab-node={String(index)}
              style={`--accent:${project.accent};--accent-2:${project.accent2};--marker:${project.marker};--node-x:${project.nodeX};--node-y:${project.nodeY};`}
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-cursor
            >
              <span class="lab-node-ring"></span>
              <span class="lab-node-core"></span>
              <span class="lab-node-label mono">
                <strong>{project.number}</strong>
                {project.nodeLabel}
              </span>
            </button>
          ))}
        </div>

        <div class="lab-field-readout mono" aria-hidden="true">
          <span>WORKBENCH FIELD</span>
          <span>ACTIVE SIGNAL</span>
        </div>
      </div>

      <aside class="lab-console" aria-label="Workbench details">
        <div class="lab-console-top">
          <div>
            <span class="lab-console-label mono">Workbench console</span>
            <strong data-lab-active-title>{labProjects[0].title}</strong>
          </div>
          <span class="lab-status mono">Live</span>
        </div>

        <div class="lab-switcher" role="tablist" aria-label="Select workbench project">
          {labProjects.map((project, index) => (
            <button
              type="button"
              class={`lab-switch mono ${index === 0 ? 'is-active' : ''}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`lab-panel-${project.id}`}
              id={`lab-tab-${project.id}`}
              data-lab-tab={String(index)}
              style={`--accent:${project.accent};`}
              data-cursor
            >
              <span>{project.number}</span>
              {project.signal}
            </button>
          ))}
        </div>

        <div class="lab-detail-stack">
          {labProjects.map((project, index) => (
            <article
              class={`lab-panel ${index === 0 ? 'is-active' : ''}`}
              id={`lab-panel-${project.id}`}
              role="tabpanel"
              aria-labelledby={`lab-tab-${project.id}`}
              data-lab-panel={String(index)}
              style={`--accent:${project.accent};--accent-2:${project.accent2};`}
            >
              <div class="lab-panel-head">
                <p class="mono">{project.mode}</p>
                <span class="mono">{project.number}</span>
              </div>

              <h3>{project.title}</h3>
              <p class="lab-description">{project.description}</p>

              <div class="lab-stats" aria-label={`${project.title} stats`}>
                {project.stats.map((item) => (
                  <div class="lab-stat">
                    <strong>{item.value}</strong>
                    <span class="mono">{item.label}</span>
                  </div>
                ))}
              </div>

              <div class="lab-proof" aria-label={`${project.title} proof points`}>
                {project.proof.map((item) => <span>{item}</span>)}
              </div>

              <div class="lab-stack" aria-label={`${project.title} stack`}>
                {project.stack.map((item) => <span>{item}</span>)}
              </div>

              {project.href && (
                <a
                  class="lab-source mono"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor
                >
                  View source
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M3.2 11.8L11.8 3.2M11.8 3.2H5.4M11.8 3.2V9.6" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}
            </article>
          ))}
        </div>
      </aside>
    </div>
  </div>
</section>

<script type="application/json" data-lab-projects set:html={JSON.stringify(labProjects)}></script>

<script>
  const root = document.querySelector('[data-lab-root]');

  if (root) {
    const dataEl = document.querySelector('[data-lab-projects]');
    const labProjects = JSON.parse(dataEl?.textContent || '[]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tabs = Array.from(root.querySelectorAll('[data-lab-tab]'));
    const nodes = Array.from(root.querySelectorAll('[data-lab-node]'));
    const panels = Array.from(root.querySelectorAll('[data-lab-panel]'));
    const activeTitle = root.querySelector('[data-lab-active-title]');
    const stage = root.querySelector('[data-lab-stage]');
    const sceneHost = root.querySelector('[data-lab-scene]');
    const mobileDetailQuery = window.matchMedia('(max-width: 640px)');
    let activeIndex = 0;
    let sceneApi;
    let gsapCleanup;

    function setActive(index) {
      const nextIndex = Math.max(0, Math.min(Number(index) || 0, labProjects.length - 1));
      activeIndex = nextIndex;
      const project = labProjects[nextIndex];

      root.style.setProperty('--active-accent', project.accent);
      root.style.setProperty('--active-accent-2', project.accent2);
      if (activeTitle) activeTitle.textContent = project.title;

      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === nextIndex;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      });

      nodes.forEach((node, nodeIndex) => {
        const selected = nodeIndex === nextIndex;
        node.classList.toggle('is-active', selected);
        node.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === nextIndex);
      });

      sceneApi?.setActive(nextIndex);
    }

    function openMobileDetail() {
      if (!mobileDetailQuery.matches) return;
      root.classList.add('lab-detail-open');
      requestAnimationFrame(() => {
        root.querySelector('.lab-console')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    function selectSibling(offset) {
      setActive((activeIndex + offset + labProjects.length) % labProjects.length);
      tabs[activeIndex]?.focus();
    }

    [...tabs, ...nodes].forEach((control) => {
      control.addEventListener('click', () => {
        setActive(control.dataset.labTab ?? control.dataset.labNode);
        if (control.hasAttribute('data-lab-node')) openMobileDetail();
      });
    });

    tabs.forEach((tab) => {
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          selectSibling(1);
        }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          selectSibling(-1);
        }
      });
    });

    async function bootScene() {
      if (reducedMotion.matches || !sceneHost) {
        root.classList.add('lab-reduced-motion');
        return;
      }

      try {
        const { initLabScene } = await import('../scripts/LabScene.js');
        sceneApi = initLabScene(sceneHost, labProjects);
        sceneApi.setActive(activeIndex);
        root.classList.add('lab-webgl-ready');
      } catch (error) {
        root.classList.add('lab-scene-static');
        console.warn('Lab scene failed to start', error);
      }
    }

    async function bootMotion() {
      if (reducedMotion.matches || !stage) return;

      try {
        const [{ gsap }, scrollModule] = await Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
        ]);
        const ScrollTrigger = scrollModule.ScrollTrigger || scrollModule.default;
        gsap.registerPlugin(ScrollTrigger);

        const media = gsap.matchMedia();
        media.add('(min-width: 921px)', () => {
          const focusTrigger = ScrollTrigger.create({
            trigger: root,
            start: 'top 16%',
            end: 'bottom 72%',
            scrub: true,
            onUpdate: (self) => setActive(self.progress > 0.52 ? 1 : 0),
          });

          const intro = gsap.timeline({
            scrollTrigger: {
              trigger: stage,
              start: 'top 78%',
              once: true,
            },
          });

          intro
            .from(root.querySelectorAll('[data-lab-node]'), {
              autoAlpha: 0,
              scale: 0.68,
              stagger: 0.16,
              duration: 0.9,
              ease: 'back.out(1.7)',
            })
            .from(root.querySelector('.lab-console'), {
              autoAlpha: 0,
              x: 42,
              duration: 0.8,
              ease: 'power3.out',
            }, '-=0.55');

          return () => {
            focusTrigger.kill();
            intro.scrollTrigger?.kill();
            intro.kill();
          };
        });

        media.add('(max-width: 920px)', () => {
          const reveal = gsap.from(root.querySelectorAll('[data-lab-node]'), {
            scrollTrigger: {
              trigger: stage,
              start: 'top 84%',
              once: true,
            },
            autoAlpha: 0,
            y: 28,
            stagger: 0.12,
            duration: 0.72,
            ease: 'power3.out',
          });

          return () => {
            reveal.scrollTrigger?.kill();
            reveal.kill();
          };
        });

        const scan = gsap.to(root.querySelector('[data-lab-scan]'), {
          xPercent: 120,
          duration: 4.2,
          ease: 'none',
          repeat: -1,
        });

        gsapCleanup = () => {
          scan.kill();
          media.revert();
        };
      } catch (error) {
        console.warn('Lab motion failed to start', error);
      }
    }

    function destroyLab() {
      sceneApi?.destroy();
      gsapCleanup?.();
    }

    setActive(0);
    requestAnimationFrame(bootScene);
    requestAnimationFrame(bootMotion);
    document.addEventListener('astro:before-swap', destroyLab, { once: true });
    window.addEventListener('pagehide', destroyLab, { once: true });
  }


</script>

<style>
  .lab-section {
    position: relative;
    z-index: 10;
    min-height: clamp(1020px, 125svh, 1260px);
    padding: clamp(5rem, 7vw, 7.5rem) var(--page-pad) clamp(1.5rem, 2.5vw, 2.5rem);
    color: #fff;
    overflow: clip;
    isolation: isolate;
  }

  .lab-container {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
  }

  .lab-heading {
    max-width: 920px;
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
  }

  .lab-kicker {
    margin: 0 0 0.9rem;
    color: var(--amber);
    font-size: var(--fs-sm);
    letter-spacing: 0.18em;
  }

  .lab-heading h2 {
    margin: 0;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: var(--fs-2xl);
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .lab-heading p:last-child {
    max-width: 640px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .lab-shell {
    --lab-sticky-top: clamp(5.2rem, 9.5svh, 6.5rem);
    position: sticky;
    top: var(--lab-sticky-top);
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.78fr);
    min-height: min(780px, calc(100svh - var(--lab-sticky-top) - 1.25rem));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(255,255,255,0.028) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
      transparent;
    background-size: 56px 56px, 56px 56px, auto;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.14),
      0 28px 90px rgba(0,0,0,0.08),
      0 0 70px color-mix(in srgb, var(--active-accent) 9%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.35);
    backdrop-filter: blur(14px) saturate(1.35);
    isolation: isolate;
    transition: box-shadow 0.45s ease;
  }

  .lab-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(255,255,255,0.09), transparent 12%, transparent 88%, rgba(255,255,255,0.09)),
      linear-gradient(180deg, rgba(255,255,255,0.09), transparent 18%, transparent 82%, rgba(255,255,255,0.08));
    opacity: 0.16;
  }

  .lab-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      repeating-linear-gradient(180deg, rgba(255,255,255,0.012) 0 1px, transparent 1px 7px),
      linear-gradient(115deg, transparent 0 38%, color-mix(in srgb, var(--active-accent) 8%, transparent) 48%, transparent 62% 100%);
    mix-blend-mode: screen;
    opacity: 0.26;
  }

  .lab-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
  }

  .lab-canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .lab-webgl-ready .lab-canvas {
    opacity: 1.0;
  }

  .lab-scene-fallback {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, transparent 0 28%, color-mix(in srgb, var(--active-accent) 8%, transparent) 38%, transparent 52% 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.018) 0 1px, transparent 1px 42px);
    opacity: 0.18;
  }

  .lab-webgl-ready .lab-scene-fallback {
    opacity: 0.035;
  }

  .lab-field {
    position: relative;
    z-index: 3;
    min-height: 100%;
    overflow: hidden;
  }

  .lab-field-grid {
    position: absolute;
    inset: 8%;
    z-index: 2;
    border: 1px solid rgba(255,255,255,0.08);
    background:
      linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, transparent, black 18%, black 82%, transparent);
    opacity: 0.16;
  }

  .lab-axis {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--active-accent), transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--active-accent) 42%, transparent);
    opacity: 0.32;
  }

  .lab-axis-x {
    left: 10%;
    right: 10%;
    top: 50%;
    height: 1px;
  }

  .lab-axis-y {
    top: 12%;
    bottom: 12%;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--active-accent-2), transparent);
  }

  .lab-scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -22%;
    z-index: 2;
    width: 20%;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--active-accent) 20%, transparent), transparent);
    opacity: 0.24;
    transform: skewX(-12deg);
  }

  .lab-node-map {
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .lab-node {
    position: absolute;
    left: var(--node-x);
    top: var(--node-y);
    width: clamp(9.2rem, 14vw, 12rem);
    min-height: 4.6rem;
    padding: 0;
    border: 0;
    color: #fff;
    background: transparent;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .lab-node-ring,
  .lab-node-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .lab-node-ring {
    width: 3.85rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--marker) 48%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 18px color-mix(in srgb, var(--marker) 12%, transparent),
      inset 0 0 18px color-mix(in srgb, var(--marker) 6%, transparent);
    opacity: 0.54;
    transition: transform 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease, opacity 0.32s ease;
  }

  .lab-node-ring::before,
  .lab-node-ring::after {
    content: "";
    position: absolute;
    inset: -0.72rem;
    border: 1px dashed color-mix(in srgb, var(--marker) 28%, transparent);
    border-radius: 50%;
    animation: lab-spin 14s linear infinite;
  }

  .lab-node-ring::after {
    inset: -1.28rem;
    border-style: solid;
    opacity: 0.18;
    animation-duration: 20s;
    animation-direction: reverse;
  }

  .lab-node-core {
    width: 0.9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--marker) 62%, rgba(255,255,255,0.2));
    background:
      radial-gradient(circle, rgba(255,255,255,0.84) 0 9%, transparent 11% 52%, color-mix(in srgb, var(--marker) 46%, transparent) 54% 61%, transparent 63%),
      conic-gradient(from 35deg, transparent 0 19%, color-mix(in srgb, var(--marker) 34%, transparent) 23% 28%, transparent 31% 72%, color-mix(in srgb, var(--marker) 28%, transparent) 75% 80%, transparent 83%);
    box-shadow:
      inset 0 0 0.34rem color-mix(in srgb, var(--marker) 9%, transparent),
      0 0 12px color-mix(in srgb, var(--marker) 36%, transparent),
      0 0 28px color-mix(in srgb, var(--marker) 16%, transparent);
    transition: transform 0.32s ease, box-shadow 0.32s ease;
  }

  .lab-node-core::before,
  .lab-node-core::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .lab-node-core::before {
    inset: -0.34rem;
    border: 1px solid color-mix(in srgb, var(--marker) 32%, transparent);
    transform: rotateX(64deg) rotateZ(-18deg);
    opacity: 0.38;
  }

  .lab-node-core::after {
    inset: 0.2rem;
    background: color-mix(in srgb, #fff 60%, var(--marker));
    box-shadow: 0 0 10px color-mix(in srgb, var(--marker) 46%, transparent);
    opacity: 0.72;
  }

  .lab-node-label {
    position: absolute;
    left: 50%;
    top: calc(50% + 3.2rem);
    min-width: max-content;
    max-width: 13rem;
    transform: translateX(-50%);
    padding: 0.48rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--marker) 44%, rgba(255,255,255,0.12));
    border-radius: 8px;
    background: rgba(8, 1, 18, 0.32);
    -webkit-backdrop-filter: blur(7px) saturate(1.18);
    backdrop-filter: blur(7px) saturate(1.18);
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-2xs);
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    text-align: center;
    transition: color 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .lab-node-label strong {
    color: var(--marker);
    margin-right: 0.4rem;
  }

  .lab-node:hover .lab-node-ring,
  .lab-node:focus-visible .lab-node-ring,
  .lab-node.is-active .lab-node-ring {
    transform: translate(-50%, -50%) scale(1.16);
    border-color: color-mix(in srgb, var(--marker) 76%, rgba(255,255,255,0.2));
    box-shadow:
      0 0 26px color-mix(in srgb, var(--marker) 24%, transparent),
      inset 0 0 20px color-mix(in srgb, var(--marker) 10%, transparent);
    opacity: 0.88;
  }

  .lab-node:hover .lab-node-core,
  .lab-node:focus-visible .lab-node-core,
  .lab-node.is-active .lab-node-core {
    transform: translate(-50%, -50%) scale(1.24);
    box-shadow:
      inset 0 0 0.36rem color-mix(in srgb, var(--marker) 11%, transparent),
      0 0 14px color-mix(in srgb, #fff 34%, var(--marker)),
      0 0 32px color-mix(in srgb, var(--marker) 22%, transparent);
  }

  .lab-node:hover .lab-node-label,
  .lab-node:focus-visible .lab-node-label,
  .lab-node.is-active .lab-node-label {
    color: #fff;
    border-color: color-mix(in srgb, var(--marker) 70%, rgba(255,255,255,0.18));
    box-shadow: 0 0 30px color-mix(in srgb, var(--marker) 12%, transparent);
  }

  .lab-field-readout {
    position: absolute;
    left: clamp(1rem, 2vw, 1.6rem);
    right: clamp(1rem, 2vw, 1.6rem);
    bottom: clamp(1rem, 2vw, 1.6rem);
    z-index: 6;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(255,255,255,0.66);
    font-size: var(--fs-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lab-console {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.55rem);
