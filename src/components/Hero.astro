---
import { impactMetrics, profile, techTicker } from '../data/portfolio';
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-grid-lines" aria-hidden="true"></div>

  <header class="hero-top">
    <a class="hero-logo mono" href="#hero" aria-label={profile.name}>
      <span data-logo-text>VT / SYSTEMS</span>
    </a>
    <div class="hero-status" aria-label="Availability">
      <span class="pulse-dot"></span>
      <span class="mono">Open to senior backend roles</span>
    </div>
  </header>

  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-kicker mono fade-up">Backend systems / data engines / AI tooling</p>
      <h1 id="hero-title" class="hero-title fade-up" style="transition-delay:0.08s">
        <span class="hero-name">Vismay Tiwari</span>
        <span>builds systems</span>
        <span class="hero-accent">that stay fast at scale.</span>
      </h1>
      <p class="hero-sub fade-up" style="transition-delay:0.16s">{profile.subhead}</p>

      <div class="hero-actions fade-up" style="transition-delay:0.24s">
        <a href={profile.links.email} class="btn-primary" data-cursor>
          Talk systems
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/>
          </svg>
        </a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>LinkedIn</a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>GitHub</a>
      </div>
    </div>

  </div>

  <div class="hero-proof-rail fade-up" style="transition-delay:0.38s" aria-label="Impact metrics">
    {impactMetrics.map((item) => (
      <div class="proof-cell">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      {[...techTicker, ...techTicker].map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.6rem var(--page-pad) 2rem;
    isolation: isolate;
  }

  .hero-section .fade-up {
    opacity: 1;
    transform: none;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 10% 22%, rgba(0, 210, 255, 0.08), transparent 25rem),
      radial-gradient(circle at 84% 18%, rgba(255, 0, 110, 0.07), transparent 23rem),
      linear-gradient(90deg, rgba(5, 0, 5, 0.34) 0%, rgba(5, 0, 5, 0.08) 48%, rgba(5, 0, 5, 0.26) 100%);
    pointer-events: none;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: clamp(42px, 5vw, 72px) clamp(42px, 5vw, 72px);
    mask-image: radial-gradient(circle at 50% 35%, black, transparent 72%);
    opacity: 0.32;
  }

  .hero-top {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-logo {
    color: rgba(255,255,255,0.86);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .hero-logo span {
    color: var(--violet-light);
    text-shadow: 0 0 20px rgba(199,125,255,0.35);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 100%;
    padding: 0.48rem 0.78rem;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 999px;
    background: rgba(5,0,5,0.52);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    color: rgba(255,255,255,0.9);
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .hero-status .mono {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-layout {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero-copy {
    width: 100%;
    max-width: 1050px;
    min-width: 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero-kicker {
    margin: 0 0 1.25rem;
    color: var(--cyan);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    position: relative;
    margin: 0;
    color: #fff;
    font-size: var(--fs-3xl);
    line-height: 0.88;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero-title span {
    display: block;
    max-width: 100%;
  }

  .hero-name {
    margin-bottom: 0.18em;
    color: rgba(255,255,255,0.92);
    font-size: 0.46em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-accent {
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 44px rgba(0,210,255,0.08);
  }

  .hero-title span:not(.hero-name) {
    opacity: 0;
    animation: title-rise 0.7s cubic-bezier(.16,1,.3,1) forwards;
  }

  .hero-title span:nth-child(2) { animation-delay: 0.08s; }
  .hero-title span:nth-child(3) { animation-delay: 0.16s; }

  @keyframes title-rise {
    from { opacity: 0; transform: translateY(0.2em); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-sub {
    max-width: 700px;
    margin: 1.55rem 0 0;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.78rem;
    margin-top: 2rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary {
    gap: 0.5rem;
    padding: 0.82rem 1.25rem;
    color: #030007;
    background: linear-gradient(135deg, #fff, var(--cyan) 38%, var(--violet-light));
    font-weight: 800;
    box-shadow: 0 18px 54px rgba(0,210,255,0.2), 0 0 30px rgba(199,125,255,0.2);
  }

  .btn-secondary {
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255,255,255,0.13);
    color: rgba(255,255,255,0.9);
    background: rgba(255,255,255,0.035);
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    transform: translateY(-2px);
  }

  .btn-secondary:hover {
    border-color: rgba(0,210,255,0.42);
    background: rgba(0,210,255,0.075);
    color: #fff;
  }

  .hero-proof-rail {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(5,0,5,0.58);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.07);
  }

  .proof-cell {
    min-width: 0;
    padding: 0.95rem;
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .proof-cell:last-child {
    border-right: 0;
  }

  .proof-cell strong {
    display: block;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-md);
    line-height: 1;
  }

  .proof-cell span {
    display: block;
    margin-top: 0.45rem;
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-xs);
    line-height: 1.35;
  }

  .hero-ticker {
    width: calc(100% + var(--page-pad) + var(--page-pad));
    margin-left: calc(0px - var(--page-pad));
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(5,0,5,0.5);
  }

  .hero-ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .hero-ticker span {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.1rem;
    color: rgba(255,255,255,0.72);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-ticker span::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-left: 1.1rem;
    border-radius: 50%;
    background: rgba(0,210,255,0.55);
    box-shadow: 0 0 12px rgba(0,210,255,0.55);
  }

  @media (max-width: 1500px) and (min-width: 1281px) {
    .hero-layout {
      gap: 3rem;
    }
  }

  @media (max-width: 1280px) {
    .hero-layout {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 2rem;
    }

    .hero-proof-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof-cell:nth-child(3n) {
      border-right: 0;
    }

    .proof-cell:nth-child(-n + 3) {
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .hero-section {
      padding-top: 5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 1rem;
      gap: 1.2rem;
    }

    .hero-top {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .hero-logo {
      max-width: 100%;
      line-height: 1.25;
    }

    .hero-status {
      flex-basis: 100%;
      width: 100%;
      min-width: 0;
      white-space: normal;
      justify-content: flex-start;
      max-width: 100%;
    }

    .hero-status .mono {
      display: block;
      min-width: 0;
      white-space: normal;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .hero-layout {
      gap: 1.5rem;
    }

    .hero-copy,
    .hero-title,
    .hero-sub,
    .hero-actions,
    .hero-proof-rail {
      max-width: calc(100vw - var(--page-pad) - var(--page-pad));
    }

    .hero-kicker {
      max-width: min(30ch, calc(100vw - var(--page-pad) - var(--page-pad)));
      font-size: var(--fs-xs);
      letter-spacing: 0.13em;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .hero-title {
      display: flex;
      flex-direction: column;
      font-size: 2.85rem;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .hero-title span {
      display: block;
    }

    .hero-title span:not(.hero-name)::after {
      content: "";
    }

    .hero-title .hero-accent::after {
      content: "";
    }

    .hero-name {
      display: block !important;
      margin-bottom: 0.3em;
      font-size: 0.52em;
    }

    .hero-sub {
      max-width: min(34ch, calc(100vw - var(--page-pad) - var(--page-pad)));
      font-size: var(--fs-sm);
      line-height: 1.58;
      overflow-wrap: anywhere;
    }

    .hero-proof-rail {
      width: 100%;
      max-width: 100%;
      grid-template-columns: 1fr;
    }

    .proof-cell,
    .proof-cell:nth-child(2n) {
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .proof-cell:last-child {
      border-bottom: 0;
    }

    .proof-cell span {
      overflow-wrap: anywhere;
    }

    .btn-primary,
    .btn-secondary {
      min-height: 44px;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      min-width: 0;
    }

    .hero-actions a {
      width: 100%;
    }

    .hero-actions .btn-primary {
      grid-column: auto;
    }
  }

  @media (max-width: 430px) {
    .hero-section {
      min-height: auto;
    }

    .hero-title {
      font-size: 2.35rem;
    }

    .proof-cell,
    .proof-cell:nth-child(2n),
    .proof-cell:nth-child(3n) {
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .proof-cell:last-child {
      border-bottom: 0;
    }
  }
</style>
