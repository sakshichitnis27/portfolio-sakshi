---
import { impactMetrics, profile, techTicker } from '../data/portfolio';
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-grid-lines" aria-hidden="true"></div>

  <header class="hero-top">
    <a class="hero-logo mono" href="#hero" aria-label={profile.name}>
      <span data-logo-text>SC / VAULT</span>
    </a>
    <div class="hero-status" aria-label="Availability">
      <span class="pulse-dot"></span>
      <span class="mono">Open to Global Opportunities</span>
    </div>
  </header>

  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-kicker mono fade-up">Java • Spring Boot • Kafka • React • Kubernetes • Cloud</p>
      <h1 id="hero-title" class="hero-title fade-up" style="transition-delay:0.08s">
        <span>Hi, I'm <em class="hero-name">Sakshi Chitnis</em></span>
        <span class="hero-accent hero-rotator" aria-live="polite">
          <span class="hero-rotator-track">
            <span class="hero-phrase active">Java Full Stack Developer.</span>
            <span class="hero-phrase">building event-driven microservices.</span>
            <span class="hero-phrase">shipping React frontends.</span>
            <span class="hero-phrase">scaling Kafka data pipelines.</span>
            <span class="hero-phrase">deploying cloud-native systems.</span>
          </span>
        </span>
      </h1>
      <p class="hero-sub fade-up" style="transition-delay:0.16s">
        Java Full Stack Developer with 4+ years of experience building event-driven microservices, React frontends, and cloud-native systems for enterprise-scale products.
      </p>

      <div class="hero-actions fade-up" style="transition-delay:0.24s">
        <a href={profile.links.email} class="btn-primary" data-cursor>
          Email Me
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6"/>
          </svg>
        </a>
        <a href={profile.links.resume} class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 2h8l4 4v16H6z" />
            <path d="M14 2v6h6" />
            <path d="M8 13h8M8 17h8M8 9h3" />
          </svg>
          View Resume
        </a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.44 5.44 0 0 0 3.5 8.55c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
          GitHub
        </a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
            <path d="M2 9h4v12H2z" />
            <path d="M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="vault-visual fade-up" style="transition-delay:0.2s" aria-label="Sakshi Enterprise DataHub visual">
      <div class="access-badge mono">
        <span class="pulse-dot"></span>
        Access Granted
      </div>
      <div class="vault-core">
        <div class="vault-door" aria-hidden="true">
          <span class="vault-ring"></span>
          <span class="vault-lock">
            <svg width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M7 11V8a5 5 0 0 1 10 0v3" />
              <path d="M5 11h14v10H5z" />
              <path d="M12 15v3" />
            </svg>
          </span>
        </div>
        <h2>Sakshi Enterprise DataHub</h2>
        <p class="mono">KAFKA_STREAMS / REACT_UI / CLOUD_NATIVE</p>
      </div>
      <div class="service-map" aria-hidden="true">
        {['NeoXam DataHub', 'Kafka 1M+/day', 'React UI', 'Feature Flags', 'Redis Cache', 'gRPC APIs', 'Elasticsearch', 'Docker/Kubernetes', 'Grafana'].map((item, index) => (
          <span class={`service-chip chip-${index}`}>{item}</span>
        ))}
      </div>
    </div>

  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      {(() => {
        const skills = [...techTicker];
        const metrics = impactMetrics.map(m => `${m.value} ${m.label}`);
        const merged: {text: string, type: string}[] = [];
        
        let sIdx = 0;
        let mIdx = 0;
        
        while (sIdx < skills.length || mIdx < metrics.length) {
          for (let i = 0; i < 3; i++) {
            if (sIdx < skills.length) {
              merged.push({text: skills[sIdx], type: 'skill'});
              sIdx++;
            }
          }
          if (mIdx < metrics.length) {
            merged.push({text: metrics[mIdx], type: 'metric'});
            mIdx++;
          }
        }
        
        return [...merged, ...merged].map((item) => (
          <span class={item.type === 'metric' ? 'ticker-metric' : 'ticker-skill'}>{item.text}</span>
        ));
      })()}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 1.6rem var(--page-pad) 2rem;
    isolation: isolate;
  }

  .hero-section .fade-up {
    opacity: 1;
    transform: none;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(120deg, rgba(34,211,238,0.08) 0 1px, transparent 1px 74px),
      linear-gradient(30deg, rgba(35,246,165,0.05) 0 1px, transparent 1px 68px),
      radial-gradient(ellipse at 78% 38%, rgba(34, 211, 238, 0.1), transparent 30rem),
      linear-gradient(90deg, rgba(2, 10, 24, 0.56) 0%, rgba(3, 16, 30, 0.16) 48%, rgba(2, 10, 24, 0.4) 100%);
    pointer-events: none;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.032) 0 1px, transparent 1px 52px),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.026) 0 1px, transparent 1px 52px),
      linear-gradient(90deg, transparent, rgba(35,246,165,0.05), transparent);
    background-size: auto;
    mask-image: linear-gradient(90deg, transparent, black 14%, black 84%, transparent);
    opacity: 0.46;
  }

  .hero-top {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-logo {
    color: rgba(255,255,255,0.86);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .hero-logo span {
    color: var(--violet-light);
    text-shadow: 0 0 20px rgba(199,125,255,0.35);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 100%;
    padding: 0.48rem 0.78rem;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 999px;
    background: rgba(5,0,5,0.52);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    color: rgba(255,255,255,0.9);
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .hero-status .mono {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-layout {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.8fr);
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero-copy {
    width: 100%;
    max-width: 1050px;
    min-width: 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .vault-visual {
    position: relative;
    min-height: clamp(430px, 44vw, 560px);
    display: grid;
    place-items: center;
    border: 1px solid rgba(0,210,255,0.16);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)),
      linear-gradient(120deg, rgba(34,211,238,0.07) 0 1px, transparent 1px 34px),
      radial-gradient(ellipse at 50% 44%, rgba(0,210,255,0.16), transparent 18rem),
      rgba(3, 13, 25, 0.52);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.1),
      0 28px 90px rgba(0,0,0,0.38),
      0 0 44px rgba(0,210,255,0.08);
    overflow: hidden;
  }

  .vault-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.032) 0 1px, transparent 1px 38px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.032) 0 1px, transparent 1px 38px);
    background-size: auto;
    mask-image: radial-gradient(circle at center, black, transparent 76%);
    opacity: 0.45;
  }

  .vault-visual::after {
    content: "";
    position: absolute;
    inset: 12%;
    border: 1px solid rgba(35,246,165,0.12);
    border-radius: 50%;
    box-shadow: 0 0 60px rgba(35,246,165,0.07);
  }

  .access-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.52rem 0.72rem;
    border: 1px solid rgba(35,246,165,0.24);
    border-radius: 999px;
    background: rgba(4, 20, 18, 0.7);
    color: rgba(235,255,248,0.92);
    font-size: var(--fs-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vault-core {
    position: relative;
    z-index: 2;
    width: min(78%, 320px);
    min-height: 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 1.4rem;
    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 8px;
    background: rgba(5,16,31,0.76);
    box-shadow: inset 0 0 36px rgba(0,210,255,0.08), 0 24px 70px rgba(0,0,0,0.32);
  }

  .vault-door {
    position: relative;
    width: 126px;
    height: 126px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(0,210,255,0.34);
    background: radial-gradient(circle, rgba(35,246,165,0.14), rgba(0,210,255,0.08) 45%, rgba(255,255,255,0.04));
    box-shadow: 0 0 42px rgba(0,210,255,0.18), inset 0 0 24px rgba(255,255,255,0.08);
  }

  .vault-ring {
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1px dashed rgba(255,255,255,0.34);
    animation: vault-spin 18s linear infinite;
  }

  .vault-lock {
    color: var(--green);
    filter: drop-shadow(0 0 16px rgba(35,246,165,0.42));
  }

  .vault-core h2 {
    max-width: 13rem;
    margin: 0;
    color: #fff;
    font-size: var(--fs-lg);
    line-height: 1.1;
  }

  .vault-core p {
    color: rgba(255,255,255,0.62);
    font-size: var(--fs-2xs);
    letter-spacing: 0.11em;
  }

  .service-map {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .service-chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    padding: 0.46rem 0.62rem;
    border: 1px solid rgba(0,210,255,0.2);
    border-radius: 8px;
    background: rgba(7, 24, 42, 0.78);
    color: rgba(255,255,255,0.86);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-2xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 0 24px rgba(0,210,255,0.08);
  }

  .chip-0 { --x: 50%; --y: 13%; }
  .chip-1 { --x: 79%; --y: 24%; }
  .chip-2 { --x: 86%; --y: 50%; }
  .chip-3 { --x: 76%; --y: 76%; }
  .chip-4 { --x: 50%; --y: 88%; }
  .chip-5 { --x: 24%; --y: 76%; }
  .chip-6 { --x: 14%; --y: 50%; }
  .chip-7 { --x: 21%; --y: 24%; }
  .chip-8 { --x: 50%; --y: 31%; }

  @keyframes vault-spin {
    to { transform: rotate(360deg); }
  }

  .hero-kicker {
    margin: 0 0 1.25rem;
    color: var(--cyan);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    position: relative;
    margin: 0;
    color: #fff;
    font-size: var(--fs-3xl);
    line-height: 1.04;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero-title span {
    display: block;
    max-width: 100%;
  }

  .hero-name {
    font-style: normal;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-accent {
    position: relative;
    display: block;
    overflow: hidden;
  }

  /* ── Rotating phrase system ──────────────────── */
  .hero-rotator {
    /* height set dynamically by JS */
    margin: 0.1em 0 0.18em;
    padding: 0.16em 0 0.38em;
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-rotator-track {
    display: block;
    position: relative;
    height: 100%;
  }

  .hero-phrase {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: block;
    line-height: 1.08;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .hero-phrase.active {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-phrase.exit {
    opacity: 0;
    transform: translateY(-100%);
  }

  .hero-title span:not(.hero-rotator):not(.hero-rotator-track):not(.hero-phrase) {
    opacity: 0;
    animation: title-rise 0.7s cubic-bezier(.16,1,.3,1) forwards;
  }

  .hero-title > span:first-child { animation-delay: 0.08s; }
  .hero-rotator { animation: title-rise 0.7s cubic-bezier(.16,1,.3,1) 0.16s forwards; opacity: 0; }

  @keyframes title-rise {
    from { opacity: 0; transform: translateY(0.2em); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-sub {
    max-width: 700px;
    margin: 1.55rem 0 0;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.78rem;
    margin-top: 2rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary {
    padding: 0.82rem 1.25rem;
    color: rgba(255,255,255,0.95);
    background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(0,210,255,0.25) 38%, rgba(199,125,255,0.22));
    border: 1px solid rgba(0,210,255,0.25);
    font-weight: 700;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 0 24px rgba(0,210,255,0.12), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .btn-secondary {
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.03);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(0,210,255,0.55);
    background: rgba(0,210,255,0.12);
    box-shadow: 0 0 30px rgba(0,210,255,0.18), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.95);
  }



  .hero-ticker {
    width: calc(100% + var(--page-pad) + var(--page-pad));
    margin-left: calc(0px - var(--page-pad));
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(5,0,5,0.5);
  }

  .hero-ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }

  .hero-ticker span {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ticker-skill {
    color: rgba(255,255,255,0.65);
  }

  .ticker-metric {
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--green), var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 8px rgba(35,246,165,0.4));
  }

  .hero-ticker span::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-left: 1.1rem;
    border-radius: 50%;
    background: rgba(0,210,255,0.55);
    box-shadow: 0 0 12px rgba(0,210,255,0.55);
  }

  @media (max-width: 1500px) and (min-width: 1281px) {
    .hero-layout {
      gap: 3rem;
    }
  }

  @media (max-width: 1280px) {
    .hero-layout {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 2rem;
    }


  }

  @media (min-width: 641px) and (max-width: 900px) {
    .hero-section {
      padding-top: 5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 1rem;
      gap: 1.2rem;
    }

    .hero-top {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .hero-logo {
      max-width: 100%;
      line-height: 1.25;
    }

    .hero-status {
      flex-basis: 100%;
      width: 100%;
      min-width: 0;
      white-space: normal;
      justify-content: flex-start;
      max-width: 100%;
    }

    .hero-status .mono {
      display: block;
      min-width: 0;
      white-space: normal;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .hero-layout {
      gap: 1.5rem;
    }

    .vault-visual {
      min-height: 380px;
    }

    .service-chip {
      font-size: 0.58rem;
      padding: 0.36rem 0.46rem;
    }

    .hero-copy,
    .hero-title,
    .hero-actions {
      max-width: calc(100vw - var(--page-pad) - var(--page-pad));
    }

    .hero-kicker {
      max-width: min(30ch, calc(100vw - var(--page-pad) - var(--page-pad)));
      font-size: var(--fs-xs);
      letter-spacing: 0.13em;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .hero-title {
      display: flex;
      flex-direction: column;
      font-size: 2.85rem;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .hero-title span {
      display: block;
    }

    .hero-title span:not(.hero-name)::after {
      content: "";
    }

    .hero-title .hero-accent::after {
      content: "";
    }

    .hero-name {
      display: inline !important;
    }



    .btn-primary,
    .btn-secondary {
      min-height: 44px;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      min-width: 0;
    }

    .hero-actions a {
      width: 100%;
    }

    .hero-actions .btn-primary {
      grid-column: auto;
    }
  }

  @media (max-width: 430px) {
    .hero-section {
      min-height: auto;
    }

    .hero-title {
      font-size: 2.35rem;
    }


  }
</style>

<script>
  const rotator = document.querySelector('.hero-rotator');
  const phrases = document.querySelectorAll('.hero-phrase');

  function measureRotator() {
    if (!rotator || !phrases.length) return;
    const fontSize = parseFloat(window.getComputedStyle(rotator).fontSize) || 16;
    const descenderGuard = Math.ceil(fontSize * 0.45);
    let maxH = 0;
    phrases.forEach(p => {
      const was = p.style.cssText;
      p.style.cssText = 'position:relative;opacity:1;transform:none;visibility:hidden;';
      maxH = Math.max(maxH, p.getBoundingClientRect().height);
      p.style.cssText = was;
    });
    rotator.style.height = Math.ceil(maxH + descenderGuard) + 'px';
  }

  measureRotator();
  document.fonts?.ready?.then(measureRotator);

  let measureFrame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(measureFrame);
    measureFrame = requestAnimationFrame(measureRotator);
  }, { passive: true });

  if (phrases.length > 1) {
    let current = 0;
    const INTERVAL = 3000;
    const TRANSITION = 550;

    setInterval(() => {
      const prev = phrases[current];
      current = (current + 1) % phrases.length;
      const next = phrases[current];

      prev.classList.remove('active');
      prev.classList.add('exit');
      next.classList.add('active');

      setTimeout(() => {
        prev.classList.remove('exit');
      }, TRANSITION);
    }, INTERVAL);
  }
</script>
