---
import { impactMetrics, profile, techTicker } from '../data/portfolio';
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-grid-lines" aria-hidden="true"></div>

  <header class="hero-top">
    <a class="hero-logo mono" href="#hero" aria-label={profile.name}>
      <span data-logo-text>VT / SYSTEMS</span>
    </a>
    <div class="hero-status" aria-label="Availability">
      <span class="pulse-dot"></span>
      <span class="mono">Open to Backend/Fullstack roles</span>
    </div>
  </header>

  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-kicker mono fade-up">Backend Heavy AI Full Stack Developer</p>
      <h1 id="hero-title" class="hero-title fade-up" style="transition-delay:0.08s">
        <span><em class="hero-name">Vismay</em> builds systems</span>
        <span class="hero-accent hero-rotator" aria-live="polite">
          <span class="hero-rotator-track">
            <span class="hero-phrase active">that scale under real traffic.</span>
            <span class="hero-phrase">that keep revenue systems reliable.</span>
            <span class="hero-phrase">that make AI workflows production-ready.</span>
            <span class="hero-phrase">that stay fast, observable, and cost-efficient.</span>
            <span class="hero-phrase">that turn data-heavy products into systems.</span>
            <span class="hero-phrase">that are owned well after launch.</span>
          </span>
        </span>
      </h1>

      <div class="hero-actions fade-up" style="transition-delay:0.24s">
        <a href={profile.links.email} class="btn-primary" data-cursor>
          Contact me
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6"/>
          </svg>
        </a>
        <a href={profile.links.stackoverflow} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 19h12v3H6z" />
            <path d="M8 15h8" />
            <path d="M8.6 11.3 16.4 13" />
            <path d="M10.2 7.7 17.4 11" />
            <path d="M13.2 4.4 19 9.2" />
          </svg>
          Stack Overflow
        </a>
        <a href={profile.links.leetcode} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16 4 8.5 11.5a3.5 3.5 0 0 0 0 5L12 20" />
            <path d="M8.5 11.5 12 8" />
            <path d="M9 15h8" />
          </svg>
          LeetCode
        </a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary" data-cursor>
          <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
            <path d="M2 9h4v12H2z" />
            <path d="M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      {(() => {
        const skills = [...techTicker];
        const metrics = impactMetrics.map(m => `${m.value} ${m.label}`);
        const merged: string[] = [];
        const max = Math.max(skills.length, metrics.length);
        for (let i = 0; i < max; i++) {
          if (i < skills.length) merged.push(skills[i]);
          if (i < metrics.length) merged.push(metrics[i]);
        }
        return [...merged, ...merged].map((item) => (
          <span>{item}</span>
        ));
      })()}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 1.6rem var(--page-pad) 2rem;
    isolation: isolate;
  }

  .hero-section .fade-up {
    opacity: 1;
    transform: none;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 10% 22%, rgba(0, 210, 255, 0.08), transparent 25rem),
      radial-gradient(circle at 84% 18%, rgba(255, 0, 110, 0.07), transparent 23rem),
      linear-gradient(90deg, rgba(5, 0, 5, 0.34) 0%, rgba(5, 0, 5, 0.08) 48%, rgba(5, 0, 5, 0.26) 100%);
    pointer-events: none;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: clamp(42px, 5vw, 72px) clamp(42px, 5vw, 72px);
    mask-image: radial-gradient(circle at 50% 35%, black, transparent 72%);
    opacity: 0.32;
  }

  .hero-top {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-logo {
    color: rgba(255,255,255,0.86);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .hero-logo span {
    color: var(--violet-light);
    text-shadow: 0 0 20px rgba(199,125,255,0.35);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 100%;
    padding: 0.48rem 0.78rem;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 999px;
    background: rgba(5,0,5,0.52);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    color: rgba(255,255,255,0.9);
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .hero-status .mono {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-layout {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero-copy {
    width: 100%;
    max-width: 1050px;
    min-width: 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero-kicker {
    margin: 0 0 1.25rem;
    color: var(--cyan);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    position: relative;
    margin: 0;
    color: #fff;
    font-size: var(--fs-3xl);
    line-height: 1.04;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero-title span {
    display: block;
    max-width: 100%;
  }

  .hero-name {
    font-style: normal;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-accent {
    position: relative;
    display: block;
    overflow: hidden;
  }

  /* ── Rotating phrase system ──────────────────── */
  .hero-rotator {
    /* height set dynamically by JS */
    margin: 0.1em 0 0.18em;
    padding: 0.16em 0 0.38em;
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-rotator-track {
    display: block;
    position: relative;
    height: 100%;
  }

  .hero-phrase {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: block;
    line-height: 1.08;
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .hero-phrase.active {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-phrase.exit {
    opacity: 0;
    transform: translateY(-100%);
  }

  .hero-title span:not(.hero-rotator):not(.hero-rotator-track):not(.hero-phrase) {
    opacity: 0;
    animation: title-rise 0.7s cubic-bezier(.16,1,.3,1) forwards;
  }

  .hero-title > span:first-child { animation-delay: 0.08s; }
  .hero-rotator { animation: title-rise 0.7s cubic-bezier(.16,1,.3,1) 0.16s forwards; opacity: 0; }

  @keyframes title-rise {
    from { opacity: 0; transform: translateY(0.2em); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-sub {
    max-width: 700px;
    margin: 1.55rem 0 0;
    color: rgba(255,255,255,0.88);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.78rem;
    margin-top: 2rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary {
    padding: 0.82rem 1.25rem;
    color: rgba(255,255,255,0.95);
    background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(0,210,255,0.25) 38%, rgba(199,125,255,0.22));
    border: 1px solid rgba(0,210,255,0.25);
    font-weight: 700;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 0 24px rgba(0,210,255,0.12), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .btn-secondary {
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.03);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(0,210,255,0.55);
    background: rgba(0,210,255,0.12);
    box-shadow: 0 0 30px rgba(0,210,255,0.18), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.95);
  }



  .hero-ticker {
    width: calc(100% + var(--page-pad) + var(--page-pad));
    margin-left: calc(0px - var(--page-pad));
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(5,0,5,0.5);
  }

  .hero-ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  .hero-ticker span {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.1rem;
    color: rgba(255,255,255,0.72);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-ticker span::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-left: 1.1rem;
    border-radius: 50%;
    background: rgba(0,210,255,0.55);
    box-shadow: 0 0 12px rgba(0,210,255,0.55);
  }

  @media (max-width: 1500px) and (min-width: 1281px) {
    .hero-layout {
      gap: 3rem;
    }
  }

  @media (max-width: 1280px) {
    .hero-layout {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 2rem;
    }


  }

  @media (min-width: 641px) and (max-width: 900px) {
    .hero-section {
      padding-top: 5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 1rem;
      gap: 1.2rem;
    }

    .hero-top {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .hero-logo {
      max-width: 100%;
      line-height: 1.25;
    }

    .hero-status {
      flex-basis: 100%;
      width: 100%;
      min-width: 0;
      white-space: normal;
      justify-content: flex-start;
      max-width: 100%;
    }

    .hero-status .mono {
      display: block;
      min-width: 0;
      white-space: normal;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .hero-layout {
      gap: 1.5rem;
    }

    .hero-copy,
    .hero-title,
    .hero-actions {
      max-width: calc(100vw - var(--page-pad) - var(--page-pad));
    }

    .hero-kicker {
      max-width: min(30ch, calc(100vw - var(--page-pad) - var(--page-pad)));
      font-size: var(--fs-xs);
      letter-spacing: 0.13em;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .hero-title {
      display: flex;
      flex-direction: column;
      font-size: 2.85rem;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .hero-title span {
      display: block;
    }

    .hero-title span:not(.hero-name)::after {
      content: "";
    }

    .hero-title .hero-accent::after {
      content: "";
    }

    .hero-name {
      display: inline !important;
    }



    .btn-primary,
    .btn-secondary {
      min-height: 44px;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
      min-width: 0;
    }

    .hero-actions a {
      width: 100%;
    }

    .hero-actions .btn-primary {
      grid-column: auto;
    }
  }

  @media (max-width: 430px) {
    .hero-section {
      min-height: auto;
    }

    .hero-title {
      font-size: 2.35rem;
    }


  }
</style>

<script>
  const rotator = document.querySelector('.hero-rotator');
  const phrases = document.querySelectorAll('.hero-phrase');

  function measureRotator() {
    if (!rotator || !phrases.length) return;
    const fontSize = parseFloat(window.getComputedStyle(rotator).fontSize) || 16;
    const descenderGuard = Math.ceil(fontSize * 0.45);
    let maxH = 0;
    phrases.forEach(p => {
      const was = p.style.cssText;
      p.style.cssText = 'position:relative;opacity:1;transform:none;visibility:hidden;';
      maxH = Math.max(maxH, p.getBoundingClientRect().height);
      p.style.cssText = was;
    });
    rotator.style.height = Math.ceil(maxH + descenderGuard) + 'px';
  }

  measureRotator();
  document.fonts?.ready?.then(measureRotator);

  let measureFrame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(measureFrame);
    measureFrame = requestAnimationFrame(measureRotator);
  }, { passive: true });

  if (phrases.length > 1) {
    let current = 0;
    const INTERVAL = 3000;
    const TRANSITION = 550;

    setInterval(() => {
      const prev = phrases[current];
      current = (current + 1) % phrases.length;
      const next = phrases[current];

      prev.classList.remove('active');
      prev.classList.add('exit');
      next.classList.add('active');

      setTimeout(() => {
        prev.classList.remove('exit');
      }, TRANSITION);
    }, INTERVAL);
  }
</script>
