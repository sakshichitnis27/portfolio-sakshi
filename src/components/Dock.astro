---
const navItems = [
  { id: 'hero', label: 'Home', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 11.5 12 4l9 7.5M5.5 10v9H10v-5h4v5h4.5v-9"/></svg>` },
  { id: 'about', label: 'About', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0"/></svg>` },
  { id: 'journey', label: 'Work', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 18c4-10 8 0 12-10 1.4-3.5 3-4 4-4"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 18h4m8-10h4M9 14h4"/></svg>` },
  { id: 'skills', label: 'Stack', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4-4 4m6 0h6M4 5h16v14H4z"/></svg>` },
  { id: 'lab', label: 'Projects', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 12 1.8 1.8L15 10"/></svg>` },
  { id: 'contact', label: 'Contact', icon: `<svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z"/><path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6"/></svg>` },
];
---

<nav id="dock" class="dock" aria-label="Portfolio sections">
  <div class="dock-inner">
    {navItems.map((item) => (
      <button
        class="dock-btn"
        data-target={item.id}
        title={item.label}
        aria-label={item.label}
      >
        <span class="dock-icon" set:html={item.icon} />
        <span class="dock-label">{item.label}</span>
      </button>
    ))}
  </div>
</nav>

<style>
  .dock {
    position: fixed;
    top: clamp(0.9rem, 2vw, 1.4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    padding: 0.42rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    background: rgba(5,0,5,0.64);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    box-shadow: 0 24px 70px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.08);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .dock-inner {
    display: flex;
    flex-direction: row;
    gap: 0.28rem;
  }

  .dock-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.48rem;
    min-width: 42px;
    min-height: 42px;
    padding: 0 0.7rem;
    border: 0;
    border-radius: 999px;
    color: rgba(255,255,255,0.5);
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .dock-btn:hover,
  .dock-btn.active {
    color: #fff;
    background: rgba(0,210,255,0.1);
    box-shadow: inset 0 0 0 1px rgba(0,210,255,0.18), 0 0 24px rgba(0,210,255,0.14);
  }

  .dock-btn:hover {
    transform: translateY(-2px);
  }

  .dock-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .dock-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    color: rgba(255,255,255,0.78);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: max-width 0.24s ease, opacity 0.2s ease;
  }

  .dock-btn:hover .dock-label,
  .dock-btn.active .dock-label {
    max-width: 6rem;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .dock {
      top: auto;
      right: auto;
      left: 50%;
      bottom: calc(0.85rem + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      max-width: calc(100vw - 1.5rem);
      padding: 0.38rem;
      border-radius: 999px;
    }

    .dock-btn {
      min-width: 42px;
      min-height: 42px;
      padding: 0 0.7rem;
    }

    .dock-btn:hover,
    .dock-btn.active {
      transform: translateY(-2px);
    }

    .dock-label {
      display: none;
    }

    .dock.is-home {
      display: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(-50%, 12px);
    }

    .dock.is-scrolling {
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 14px);
    }

    .dock.is-content-focus {
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 14px);
    }
  }
</style>

<script>
  const dockBtns = document.querySelectorAll('.dock-btn');
  const dock = document.getElementById('dock');
  const sections = ['hero', 'about', 'journey', 'skills', 'lab', 'contact'];
  let ticking = false;
  let dockScrollTimer;

  function setActive(id) {
    dock?.classList.toggle('is-home', id === 'hero' || window.scrollY < 180);
    dock?.classList.toggle('is-content-focus', id === 'skills');
    dockBtns.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-target') === id);
    });
  }

  function syncHeroDock() {
    if (window.scrollY < 180) {
      dock?.classList.add('is-home');
      return;
    }
    const active = document.querySelector('.dock-btn.active')?.getAttribute('data-target');
    dock?.classList.toggle('is-home', active === 'hero');
  }

  dockBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      const el = target ? document.getElementById(target) : null;
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  function getCurrentSection() {
    if (window.scrollY < 180) return 'hero';
    const anchor = window.innerHeight * 0.36;
    let current = 'hero';
    sections.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      const rect = el.getBoundingClientRect();
      if (rect.top <= anchor && rect.bottom > anchor) current = id;
    });
    return current;
  }

  function updateActiveFromScroll() {
    ticking = false;
    setActive(getCurrentSection());
  }

  function requestActiveUpdate() {
    if (window.matchMedia('(max-width: 640px)').matches && window.scrollY > 180) {
      dock?.classList.add('is-scrolling');
      window.clearTimeout(dockScrollTimer);
      dockScrollTimer = window.setTimeout(() => dock?.classList.remove('is-scrolling'), 900);
    }
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActiveFromScroll);
  }

  setActive('hero');
  syncHeroDock();
  document.addEventListener('scroll', requestActiveUpdate, { passive: true });
  window.addEventListener('resize', requestActiveUpdate, { passive: true });
</script>
