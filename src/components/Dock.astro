---
// Dock navigation component
const navItems = [
  { id: 'hero', label: 'Home', icon: `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>` },
  { id: 'about', label: 'About', icon: `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>` },
  { id: 'experience', label: 'Work', icon: `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z"/></svg>` },
  { id: 'skills', label: 'Skills', icon: `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>` },
  { id: 'contact', label: 'Contact', icon: `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>` },
];
---

<nav id="dock" class="dock">
  <div class="dock-inner">
    {navItems.map((item) => (
      <button
        class="dock-btn"
        data-target={item.id}
        title={item.label}
        aria-label={item.label}
      >
        <span class="dock-icon" set:html={item.icon} />
        <span class="dock-label">{item.label}</span>
        <span class="dock-dot"></span>
      </button>
    ))}
  </div>
</nav>

<style>
  .dock {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: rgba(10, 10, 10, 0.8);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .dock-inner {
    display: flex;
    gap: 0.25rem;
    align-items: flex-end;
  }

  .dock-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.6rem 0.75rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.5);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    min-width: 52px;
  }

  .dock-btn:hover,
  .dock-btn.active {
    color: var(--violet-light);
    background: rgba(157, 78, 221, 0.08);
    transform: translateY(-6px) scale(1.1);
  }

  .dock-btn:hover .dock-icon,
  .dock-btn.active .dock-icon {
    filter: drop-shadow(0 0 8px rgba(157,78,221,0.7));
  }

  .dock-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .dock-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
  }

  .dock-btn:hover .dock-label,
  .dock-btn.active .dock-label {
    opacity: 1;
    transform: translateY(0);
  }

  .dock-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--violet);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .dock-btn.active .dock-dot {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .dock { bottom: 1rem; padding: 0.4rem 0.5rem; border-radius: 16px; }
    .dock-btn { padding: 0.5rem 0.6rem; min-width: 44px; }
    .dock-label { display: none; }
  }
</style>

<script>
  const dockBtns = document.querySelectorAll('.dock-btn');
  const sections = ['hero', 'about', 'experience', 'skills', 'contact'];

  // Smooth scroll on click
  dockBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      const el = document.getElementById(target!);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Active state on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        dockBtns.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-target') === id);
        });
      }
    });
  }, { threshold: 0.4 });

  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Set home as default active
  const homeBtn = document.querySelector('.dock-btn[data-target="hero"]');
  if (homeBtn) homeBtn.classList.add('active');
</script>
