---
import { profile } from '../data/portfolio';

const aboutStats = [
  { label: 'Experience', value: '5+ years' },
  { label: 'Current role', value: 'Software Engineer 3' },
  { label: 'Location', value: profile.location },
  { label: 'Work scope', value: 'Global / remote' },
  { label: 'Specialty', value: 'Backend-heavy full stack' },
  { label: 'Systems', value: 'Payments / data / LLM' },
];
---

<section id="about" class="section about-section">
  <div class="about-container">
    <div class="section-header fade-up">
      <div class="section-num">01 / ABOUT</div>
      <h2 class="section-title">Backend-heavy full stack engineer for revenue, data, and <span>AI systems</span>.</h2>
    </div>

    <div class="about-layout fade-up" style="transition-delay:0.1s">
      <div class="about-bio">
        <p class="bio-lead">
          <span class="bio-accent">Backend-heavy full stack engineer for revenue, data, and AI systems.</span>
        </p>
        <p>
          I like building the systems a product clearly needs, and the unusual things imagination demands.
        </p>
        <p>
          I build product systems where latency, correctness, and cost matter: payments, subscriptions, experimentation, search, caching, realtime data, and LLM workflows.
        </p>
        <p>
          I am strongest at turning ambiguous product ideas into production paths: schema, APIs, queues, query plans, rollout controls, metrics, and operational follow-through.
        </p>
        <p>
          I work well with platform, product, and data teams when the problem needs both shipping speed and systems discipline.
        </p>
        <p>
          I have strong experience as an IC and in close collaboration with PMs, analysts, QA, and other engineers.
        </p>
        <p>
          I also have solid frontend experience, mainly with TypeScript, React, and smaller frameworks; this portfolio is one example of that work.
        </p>
      </div>

      <div class="about-meta">
        <div class="about-stats" aria-label="Profile facts">
          {aboutStats.map((item) => (
            <div class="stat-card">
              <span class="stat-label mono">{item.label}</span>
              <span class="stat-value">{item.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section { background: transparent; }

  .about-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .section-title {
    max-width: 980px;
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: 0;
    margin-top: 0.75rem;
    color: #fff;
    line-height: 0.96;
    text-wrap: balance;
  }

  .section-title span {
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.48fr);
    gap: clamp(1rem, 3vw, 2.2rem);
    align-items: stretch;
    margin-top: 3rem;
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.07), rgba(255,255,255,0.018) 48%),
      radial-gradient(circle at 8% 0%, rgba(0,210,255,0.08), transparent 18rem),
      rgba(4, 1, 12, 0.34);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.12),
      0 24px 70px rgba(0,0,0,0.18);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    backdrop-filter: blur(14px) saturate(1.25);
  }

  .bio-lead {
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .bio-accent {
    font-weight: 700;
    font-size: var(--fs-md);
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0;
  }

  .about-bio p {
    font-size: var(--fs-base);
    color: rgba(255,255,255,0.82);
    line-height: 1.72;
  }

  .bio-highlight {
    color: #c77dff;
    font-weight: 600;
  }

  .about-meta {
    display: flex;
    min-width: 0;
  }

  .about-stats {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    height: 100%;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.55rem;
    min-height: 6.4rem;
    padding: 0.9rem;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.075), rgba(255,255,255,0.018) 58%),
      rgba(5, 0, 16, 0.32);
    border: 1px solid rgba(255,255,255,0.115);
    border-radius: 8px;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.11),
      0 18px 48px rgba(0,0,0,0.14);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  .stat-label {
    font-size: var(--fs-2xs);
    color: var(--cyan);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stat-value {
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.32;
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }

    .about-meta {
      display: block;
    }

    .about-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: none;
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .about-layout {
      margin-top: 2rem;
    }

    .about-bio {
      padding: 1rem;
    }

    .about-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .stat-card {
      min-height: 5.7rem;
      padding: 0.75rem;
    }

    .stat-value {
      font-size: var(--fs-sm);
    }
  }
</style>
