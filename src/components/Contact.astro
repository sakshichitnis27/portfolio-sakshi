---
import { certs, profile, socials } from '../data/portfolio';
---

<section id="contact" class="contact-section">
  <div class="contact-container">
    <div class="contact-cta fade-up">
      <div class="section-num">05 / CONTACT</div>
      <h2 class="cta-heading">
        <span>Bring me the</span>
        <span class="text-gradient">hard backend + AI</span>
        <span>problems.</span>
      </h2>
      <p class="cta-sub">
        Senior backend roles, platform teams, revenue systems, data-heavy products,
        LLM systems, and AI-native engineering workflows. Based in {profile.location}; open globally.
      </p>

      <div class="contact-links">
        {socials.map((s) => (
          <a href={s.href} target={s.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" class="contact-social" data-cursor>
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={s.icon} />
            </svg>
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="contact-note fade-up">
      <span class="mono">RESUME</span>
      <p>Public copy is sanitized. Clean PDF available on request.</p>
    </div>

    <div class="h-line contact-div fade-up"></div>

    <div class="contact-meta fade-up">
      <div class="meta-block">
        <div class="meta-label mono">CERTIFICATIONS</div>
        {certs.map((c) => (
          <div class="cert-item">
            <span class="cert-dot"></span>
            <span class="cert-name">{c}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-name" aria-hidden="true">VISMAYTIWARI</div>

    <div class="footer-bar fade-up">
      <span class="mono">&copy; <span id="footer-year"></span> {profile.name}</span>
      <span class="mono">Static Astro frontend / GitHub Pages ready</span>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    z-index: 10;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.06);
    background:
      radial-gradient(circle at 12% 18%, rgba(0,210,255,0.14), transparent 24rem),
      radial-gradient(circle at 82% 30%, rgba(255,0,110,0.12), transparent 24rem),
      radial-gradient(circle at 45% 84%, rgba(35,246,165,0.12), transparent 22rem),
      rgba(5,0,5,0.3);
  }

  .contact-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7rem) var(--page-pad) 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .cta-heading {
    display: flex;
    flex-direction: column;
    margin: 1rem 0;
    color: #fff;
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .cta-sub {
    max-width: 680px;
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-md);
    line-height: 1.7;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .contact-social {
    display: inline-flex;
    align-items: center;
    gap: 0.52rem;
    min-height: 44px;
    padding: 0.72rem 1rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    color: rgba(255,255,255,0.86);
    background: rgba(255,255,255,0.035);
    text-decoration: none;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .contact-social:hover {
    border-color: rgba(0,210,255,0.46);
    color: #fff;
    background: rgba(0,210,255,0.08);
    transform: translateY(-2px);
  }

  .contact-note {
    max-width: 760px;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    background: rgba(255,255,255,0.035);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .contact-note span {
    display: block;
    color: var(--cyan);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    margin-bottom: 0.45rem;
  }

  .contact-note p {
    margin: 0;
    color: rgba(255,255,255,0.9);
    font-size: var(--fs-sm);
    line-height: 1.58;
  }

  .contact-div {
    margin: 0;
  }

  .contact-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .meta-label {
    margin-bottom: 1rem;
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 0.58rem;
    margin-bottom: 0.58rem;
  }

  .cert-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 14px rgba(0,210,255,0.75);
  }

  .cert-name {
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-sm);
  }

  .footer-name {
    overflow: hidden;
    margin-bottom: -0.15em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.055);
    user-select: none;
    pointer-events: none;
    font-size: clamp(4.3rem, 13.5vw, 13.5rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 calc(1.25rem + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer-bar span {
    color: rgba(255,255,255,0.82);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .contact-meta {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .cta-heading {
      font-size: clamp(2rem, 10vw, 3.8rem);
      line-height: 0.96;
    }

    .footer-bar {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  const year = document.getElementById('footer-year');
  if (year) year.textContent = new Date().getFullYear();
</script>
