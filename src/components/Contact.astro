---
import { socials } from '../data/portfolio';

const contactSocials = socials.filter((social) => ['Email', 'LinkedIn'].includes(social.label));
---

<section id="contact" class="contact-section">
  <div class="contact-container">
    <div class="contact-cta fade-up">
      <div class="section-num">05 / CONTACT</div>
      <h2 class="cta-heading">
        <span>Open for senior</span>
        <span class="text-gradient">and lead engineering</span>
        <span>roles globally.</span>
      </h2>
      <p class="cta-sub">
        I have built backend-heavy products across revenue systems, data platforms, LLM tooling,
        and reliability work. Bonus: I can build the frontend too when the product needs a complete path from systems depth to user-facing polish.
      </p>

      <div class="contact-links">
        {contactSocials.map((s) => (
          <a href={s.href} target={s.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" class="contact-social" data-cursor>
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={s.icon} />
            </svg>
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="footer-name" aria-hidden="true">
      <svg class="footer-name-svg" viewBox="0 0 900 160" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="footerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" class="grad-stop-1" />
            <stop offset="50%" class="grad-stop-2" />
            <stop offset="100%" class="grad-stop-3" />
          </linearGradient>
        </defs>
        <text x="50%" y="138" text-anchor="middle" class="footer-name-text">VISMAY</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    z-index: 10;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(0,210,255,0.08), transparent 24rem),
      radial-gradient(circle at 82% 30%, rgba(255,0,110,0.07), transparent 24rem),
      radial-gradient(circle at 45% 84%, rgba(35,246,165,0.07), transparent 22rem);
  }

  .contact-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(2rem, 3.5vw, 3.5rem) var(--page-pad) 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .cta-heading {
    display: flex;
    flex-direction: column;
    margin: 1rem 0;
    color: #fff;
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .cta-sub {
    max-width: 680px;
    color: rgba(255,255,255,0.86);
    font-size: var(--fs-md);
    line-height: 1.7;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .contact-social {
    display: inline-flex;
    align-items: center;
    gap: 0.52rem;
    min-height: 44px;
    padding: 0.72rem 1rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    color: rgba(255,255,255,0.86);
    background: rgba(255,255,255,0.035);
    text-decoration: none;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .contact-social:hover {
    border-color: rgba(0,210,255,0.46);
    color: #fff;
    background: rgba(0,210,255,0.08);
    transform: translateY(-2px);
  }

  .footer-name {
    position: relative;
    overflow: hidden;
    margin-bottom: -0.15em;
    user-select: none;
    pointer-events: none;
    line-height: 1;
  }

  .footer-name-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-name-text {
    font-family: 'Outfit', sans-serif;
    font-size: 168px;
    font-weight: 900;
    letter-spacing: 0.04em;
    fill: url(#footerGrad);
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 1.5;
    stroke-linecap: round;
    paint-order: stroke fill;
    animation: shiftFooterColor 10s linear infinite;
  }

  @keyframes shiftFooterColor {
    0%   { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  .grad-stop-1 {
    stop-color: rgba(0, 210, 255, 0.4);
  }
  .grad-stop-2 {
    stop-color: rgba(199, 125, 255, 0.4);
  }
  .grad-stop-3 {
    stop-color: rgba(255, 184, 77, 0.4);
  }

  @media (max-width: 760px) {
    .cta-heading {
      font-size: clamp(2rem, 10vw, 3.8rem);
      line-height: 0.96;
    }
  }
</style>
