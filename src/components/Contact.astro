---
const socials = [
  { label: 'Email', href: 'mailto:hire.vtiwari@gmail.com?subject=Hey%20Vismay%20%E2%80%94%20Let%27s%20connect', icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/vismaytiwari/', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z M2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z' },
  { label: 'GitHub', href: 'https://github.com/vismaytiwari', icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22' },
  { label: 'LeetCode', href: 'https://leetcode.com/u/vismaytiwari/', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5' },
  { label: 'StackOverflow', href: 'https://stackoverflow.com/users/10820780/vismay', icon: 'M20 20H4v-4h16v4zM7 17h10M6.8 12.8l9.4 2 .4-1.9-9.4-2zM8.3 8.5l8.7 4 .9-1.7-8.7-4zM12 2L5.5 7.5l1.2 1.5L12 4.5l5.3 4.5 1.2-1.5z' },
];

const education = [
  {
    degree: 'B.Tech, Computer Science',
    school: 'Medicaps University, Indore',
    year: '2017 — 2021',
    grade: '8.7 CGPA',
  },
];

const certs = [
  'AWS Solutions Architect — Associate',
  'IBM Machine Learning Practitioner',
];
---

<section id="contact" class="contact-section">
  <div class="contact-container">

    <!-- Big CTA text -->
    <div class="contact-cta fade-up">
      <div class="section-num">04 — CONTACT</div>
      <h2 class="cta-heading">
        <span>BUILD</span>
        <span class="text-gradient">RELIABLE SYSTEMS</span>
        <span>AT SCALE.</span>
      </h2>
      <p class="cta-sub">
        Senior backend engineer for distributed systems, payments, data pipelines, and LLM tooling.<br>
        Based in Bengaluru; open to senior backend roles globally.
      </p>

      <div class="contact-links">
        {socials.map(s => (
          <a href={s.href} target={s.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" class="contact-social" data-cursor>
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d={s.icon} />
            </svg>
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Divider -->
    <div class="h-line contact-div fade-up"></div>

    <!-- Education + Certs -->
    <div class="contact-meta fade-up">
      <div class="meta-block">
        <div class="meta-label mono">EDUCATION</div>
        {education.map(e => (
          <div class="edu-item">
            <div class="edu-degree">{e.degree}</div>
            <div class="edu-school mono">{e.school} · {e.year} · {e.grade}</div>
          </div>
        ))}
      </div>

      <div class="meta-block">
        <div class="meta-label mono">CERTIFICATIONS</div>
        {certs.map(c => (
          <div class="cert-item">
            <span class="cert-dot">✦</span>
            <span class="cert-name">{c}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Giant footer name -->
    <div class="footer-name" aria-hidden="true">VISMAYTIWARI</div>

    <!-- Footer bar -->
    <div class="footer-bar fade-up">
      <span class="mono" style="font-size:0.7rem;color:rgba(255,255,255,0.45);">© <span id="footer-year"></span> Vismay Tiwari</span>
      <span class="mono" style="font-size:0.7rem;color:rgba(255,255,255,0.45);">Built with Astro + Three.js</span>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: #050005;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-bottom: 0;
  }

  .contact-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 6rem 2rem 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .cta-heading {
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    display: flex;
    flex-direction: column;
    margin: 1rem 0;
    color: #fff;
  }

  .cta-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.55);
    font-family: 'JetBrains Mono', monospace;
    line-height: 1.6;
    max-width: 500px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .contact-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .contact-social:hover {
    border-color: var(--violet);
    color: var(--violet-light);
    background: rgba(157,78,221,0.07);
    transform: translateY(-2px);
  }

  .contact-div { margin: 0; }

  .contact-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .meta-label {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.3);
    margin-bottom: 1rem;
  }

  .edu-degree { font-size: 0.9rem; color: rgba(255,255,255,0.75); font-weight: 500; }
  .edu-school {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.52);
    margin-top: 0.25rem;
    letter-spacing: 0.04em;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cert-dot { color: var(--violet); font-size: 0.6rem; }
  .cert-name { font-size: 0.85rem; color: rgba(255,255,255,0.55); }

  /* Giant footer name */
  .footer-name {
    font-size: clamp(5rem, 14vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.05);
    user-select: none;
    pointer-events: none;
    line-height: 1;
    margin-bottom: -0.15em;
    overflow: hidden;
  }

  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  @media (max-width: 768px) {
    .contact-meta { grid-template-columns: 1fr; gap: 1.5rem; }
    .cta-heading { font-size: clamp(3rem, 13vw, 5rem); }
    .contact-container { padding: 4rem 1.5rem 0; }
  }
</style>

<script>
  const el = document.getElementById('footer-year');
  if (el) el.textContent = new Date().getFullYear();
</script>
