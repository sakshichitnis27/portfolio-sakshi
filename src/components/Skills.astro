---
---

<section id="skills" class="skills-section" aria-labelledby="skills-title">
  <div class="skills-container">
    <div class="skills-copy">
      <p class="skills-kicker">03 / STACK</p>
      <h2 id="skills-title">Full stack and cloud-native <span>toolkit</span>.</h2>
      <p class="skills-hint">Java/Spring backend, React frontends, Kafka streaming, data platforms, cloud delivery, observability, security, testing, and AI productivity.</p>
    </div>
  </div>
  <div class="sk-universe" id="sk-universe"></div>
</section>

<style is:global>
  .skills-section {
    position: relative;
    min-height: 100vh;
    padding: clamp(72px, 8vw, 120px) var(--page-pad) clamp(72px, 8vw, 120px);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .skills-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .skills-copy {
    position: relative;
    z-index: 3;
    max-width: 760px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .skills-kicker {
    color: var(--nebula-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--fs-sm);
    font-weight: 700;
    margin: 0 0 0.9rem;
  }

  .skills-copy h2 {
    max-width: 820px;
    font-size: var(--fs-2xl);
    line-height: 0.96;
    letter-spacing: 0;
    margin: 0 0 1rem;
    color: #fff;
    text-wrap: balance;
  }

  .skills-copy h2 span {
    background: var(--nebula-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .skills-hint {
    max-width: 620px;
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Access map container ────────────────────── */
  .sk-universe {
    position: relative;
    width: 100%;
    height: clamp(620px, 58vw, 760px);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .skills-section {
      padding-bottom: calc(7.5rem + env(safe-area-inset-bottom));
    }

    .sk-universe {
      height: clamp(980px, 250vw, 1120px);
    }
  }

  /* ── Encrypted particle intro ─────────────────── */
  .sk-starfield {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .sk-star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--sz, 2px);
    height: var(--sz, 2px);
    background: white;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 0 calc(var(--sz, 2px) + 1px) rgba(255, 255, 255, 0.5);
    animation: sk-twinkle var(--dur, 3s) ease-in-out var(--del, 0s) infinite;
  }

  @keyframes sk-twinkle {
    0%, 100% { opacity: 0.15; transform: scale(0.8); }
    50%      { opacity: var(--bright, 0.75); transform: scale(1.3); }
  }

  /* Warp: stars streak toward center */
  .sk-universe.warping .sk-star {
    animation: sk-warp 1.6s cubic-bezier(0.55, 0, 0.98, 0.2) var(--wd, 0ms) forwards;
  }

  @keyframes sk-warp {
    0%   { transform: translate(0, 0) rotate(var(--ang, 0deg)) scaleX(1) scaleY(1);
           opacity: var(--bright, 0.7); }
    40%  { opacity: 1; }
    75%  { transform: translate(calc(var(--dx) * 0.7), calc(var(--dy) * 0.7))
                      rotate(var(--ang, 0deg)) scaleX(5) scaleY(0.3);
           opacity: 0.9; }
    100% { transform: translate(var(--dx), var(--dy))
                      rotate(var(--ang, 0deg)) scaleX(10) scaleY(0.15);
           opacity: 0; }
  }

  /* ── Warp Explosion: soft nebula pulse ─────────── */

  /* Layer 1: Nebula nova — soft multi-color radial glow */
  .sk-universe::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 50px; height: 50px;
    margin: -25px 0 0 -25px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(157, 78, 221, 0.6) 0%,
      rgba(0, 210, 255, 0.3) 22%,
      rgba(255, 184, 77, 0.12) 45%,
      rgba(157, 78, 221, 0.04) 70%,
      transparent 100%);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
    z-index: 6;
    will-change: transform, opacity;
  }

  /* Layer 2: Soft expanding glow ring (no solid border) */
  .sk-universe::before {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 40px; height: 40px;
    margin: -20px 0 0 -20px;
    border-radius: 50%;
    background: radial-gradient(circle,
      transparent 55%,
      rgba(0, 210, 255, 0.18) 70%,
      rgba(157, 78, 221, 0.12) 85%,
      transparent 100%);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
    z-index: 7;
    will-change: transform, opacity;
  }

  /* Layer 3: Tiny bright core flash */
  .sk-starfield::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 12px; height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(199, 125, 255, 0.5) 35%,
      rgba(157, 78, 221, 0.15) 65%,
      transparent 100%);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
    z-index: 8;
    will-change: transform, opacity;
  }

  /* Layer 4: Secondary soft glow wave */
  .sk-starfield::before {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 36px; height: 36px;
    margin: -18px 0 0 -18px;
    border-radius: 50%;
    background: radial-gradient(circle,
      transparent 50%,
      rgba(255, 184, 77, 0.10) 68%,
      rgba(255, 184, 77, 0.04) 85%,
      transparent 100%);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
    z-index: 7;
    will-change: transform, opacity;
  }

  /* ── Warp trigger animations ─────────────────────── */
  .sk-universe.warping::before {
    animation: sk-glow-ring 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.0s forwards;
  }
  .sk-universe.warping::after {
    animation: sk-nova 1.6s cubic-bezier(0.22, 1, 0.36, 1) 1.15s forwards;
  }
  .sk-universe.warping .sk-starfield::after {
    animation: sk-core 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.1s forwards;
  }
  .sk-universe.warping .sk-starfield::before {
    animation: sk-glow-ring2 1.6s cubic-bezier(0.16, 1, 0.3, 1) 1.3s forwards;
  }

  @keyframes sk-glow-ring {
    0%   { transform: scale(0); opacity: 0; }
    8%   { opacity: 0.4; }
    35%  { opacity: 0.2; }
    100% { transform: scale(20); opacity: 0; }
  }

  @keyframes sk-nova {
    0%   { transform: scale(0); opacity: 0; }
    8%   { transform: scale(1); opacity: 0.7; }
    25%  { opacity: 0.4; }
    100% { transform: scale(10); opacity: 0; }
  }

  @keyframes sk-core {
    0%   { transform: scale(0); opacity: 0; }
    20%  { transform: scale(4); opacity: 1; }
    100% { transform: scale(6); opacity: 0; }
  }

  @keyframes sk-glow-ring2 {
    0%   { transform: scale(0); opacity: 0; }
    10%  { opacity: 0.35; }
    100% { transform: scale(16); opacity: 0; }
  }

  /* After warp: hide starfield */
  .sk-universe.revealed .sk-starfield {
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  /* ── Hub buttons ─────────────────────────────────── */
  .sk-hub {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 99px;
    padding: 5px 13px;
    font-size: var(--fs-2xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    border: 1.5px solid var(--color);
    color: var(--color);
    background: rgba(5, 0, 5, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    white-space: nowrap;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.55s ease var(--rd, 0ms),
      background 0.35s ease,
      color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.25s ease;
  }

  /* Hub glow aura */
  .sk-hub::after {
    content: '';
    position: absolute;
    inset: -18px -12px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color), transparent 68%);
    opacity: 0.1;
    filter: blur(10px);
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .sk-hub:hover::after { opacity: 0.28; }
  .sk-hub.active::after { opacity: 0.4; }

  .sk-universe.revealed .sk-hub {
    opacity: 1;
    pointer-events: auto;
    animation: hub-glow 3.5s ease-in-out infinite, hub-ping 2.8s ease-out var(--rd, 0ms) 1;
  }

  .sk-hub:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .sk-hub.active {
    background: var(--color) !important;
    color: #05000a !important;
    box-shadow: 0 0 30px var(--color) !important;
    animation: none !important;
    transform: translate(-50%, -50%) scale(1.06) !important;
  }

  /* Hub radar-ping pulse */
  @keyframes hub-ping {
    0%   { box-shadow: 0 0 0 0 var(--color), 0 0 7px var(--color); opacity: 0.6; }
    60%  { box-shadow: 0 0 0 22px transparent, 0 0 7px var(--color); opacity: 1; }
    100% { box-shadow: 0 0 0 22px transparent, 0 0 20px var(--color); opacity: 1; }
  }

  @keyframes hub-glow {
    0%, 100% { box-shadow: 0 0 7px var(--color); }
    50%       { box-shadow: 0 0 20px var(--color); }
  }

  /* ── Orbit rings (3D tilt) ───────────────────────── */
  .sk-orbit {
    position: absolute;
    border-radius: 50%;
    border: 1.5px dashed rgba(255, 255, 255, 0.14);
    pointer-events: none;
    transform: translate(-50%, -50%) perspective(600px) rotateX(62deg);
    opacity: 0;
    transition: opacity 0.6s ease var(--rd, 0ms), border-color 0.4s ease, box-shadow 0.4s ease;
    box-shadow: 0 0 0 0 var(--color, transparent);
  }

  .sk-universe.revealed .sk-orbit { opacity: 1; }

  /* Colored ring when its cluster is active */
  .sk-orbit.active {
    border-color: color-mix(in srgb, var(--color) 40%, transparent);
    box-shadow: 0 0 18px -3px var(--color);
  }

  /* ── Pulse ripple: center → orbit edge ─────────── */
  .sk-orbit::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--color, rgba(255,255,255,0.2));
    opacity: 0;
    transform: scale(0);
    pointer-events: none;
  }

  /* Pulse fires on hover (JS toggles .hovered) */
  .sk-orbit.hovered::before {
    animation: orbit-pulse 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  @keyframes orbit-pulse {
    0%   { transform: scale(0.05); opacity: 0.7; }
    60%  { opacity: 0.35; }
    100% { transform: scale(1.02); opacity: 0; }
  }

  /* ── Focus dim: subtle only ── */
  .sk-universe.focused .sk-hub:not(.active) {
    opacity: 0.75;
    filter: grayscale(0.05);
    transition: opacity 0.4s ease, filter 0.4s ease,
                background 0.35s ease, color 0.35s ease,
                box-shadow 0.35s ease, transform 0.25s ease;
  }

  .sk-universe.focused .sk-node:not(.expanded) {
    opacity: 0.82 !important;
  }

  .sk-universe.focused .sk-orbit:not(.active) {
    opacity: 0.75;
  }

  /* ── Skill nodes ─────────────────────────────────── */
  .sk-node {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease var(--rd, 0ms);
  }

  .sk-universe.revealed .sk-node {
    opacity: 0.88;
    pointer-events: auto;
  }

  .sk-universe.revealed .sk-node.expanded { opacity: 1; }

  .sk-node-icon {
    width: 30px;
    height: 30px;
    padding: 5px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    transition:
      width        0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      height       0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      padding      0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      background   0.35s ease,
      border-color 0.35s ease,
      box-shadow   0.35s ease;
  }

  .sk-node-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .sk-node-label {
    font-size: var(--fs-2xs);
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    pointer-events: none;
    text-align: center;
    font-weight: 500;
    transition:
      opacity    0.3s ease 0.08s,
      max-height 0.3s ease 0.04s,
      font-size  0.3s ease;
  }

  /* — Expanded state — */
  .sk-node.expanded .sk-node-icon {
    width: 62px;
    height: 62px;
    padding: 12px;
    border-radius: 50%;
    background: rgba(20, 10, 36, 0.92);
    border-color: var(--color, rgba(255,255,255,0.35));
    border-width: 2px;
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--color, #9d4edd) 18%, transparent),
      0 0 28px color-mix(in srgb, var(--color, #9d4edd) 45%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.12);
  }

  .sk-node.expanded .sk-node-label {
    opacity: 1;
    max-height: 20px;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.88);
  }

  .sk-node:hover .sk-node-icon {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.12);
  }

  /* Icon text fallback (when CDN image fails) */
  .sk-icon-text {
    font-size: var(--fs-2xs);
    font-weight: 800;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    font-family: inherit;
    transition: font-size 0.4s ease;
  }

  .sk-node.expanded .sk-icon-text { font-size: var(--fs-sm); }

  /* ── Mobile: smaller expanded icons so nodes don't collide ── */
  @media (max-width: 768px) {
    .sk-node.expanded .sk-node-icon {
      width: 42px;
      height: 42px;
      padding: 8px;
      border-radius: 50%;
    }
    .sk-node.expanded .sk-node-label { font-size: var(--fs-2xs); }
    .sk-node.expanded .sk-icon-text  { font-size: var(--fs-xs); }
    .skills-copy h2 { font-size: var(--fs-2xl); }
  }
</style>

<script>
(function () {
  const CLUSTERS = [
    {
      id: 'core', label: 'BACKEND CORE', color: '#22d3ee',
      dp: [12, 26], mp: [24, 11],
      skills: [
        { name: 'Java',        slug: 'openjdk',    url: 'https://openjdk.org' },
        { name: 'Spring Boot', slug: 'springboot', url: 'https://spring.io/projects/spring-boot' },
        { name: 'Spring MVC',  slug: 'spring',     url: 'https://spring.io' },
        { name: 'Spring Cloud', slug: 'spring',    url: 'https://spring.io/projects/spring-cloud' },
        { name: 'REST APIs',   slug: 'swagger',    url: 'https://swagger.io' },
        { name: 'gRPC',        slug: 'grpc',       url: 'https://grpc.io' },
        { name: 'Hibernate',   slug: 'hibernate',  url: 'https://hibernate.org' },
        { name: 'Maven',       slug: 'apachemaven', url: 'https://maven.apache.org' },
      ]
    },
    {
      id: 'frontend', label: 'FRONTEND', color: '#38bdf8',
      dp: [32, 26], mp: [74, 19],
      skills: [
        { name: 'React.js',    slug: 'react',      url: 'https://react.dev' },
        { name: 'Angular',     slug: 'angular',    url: 'https://angular.dev' },
        { name: 'TypeScript',  slug: 'typescript', url: 'https://typescriptlang.org' },
        { name: 'JavaScript',  slug: 'javascript', url: 'https://developer.mozilla.org/docs/Web/JavaScript' },
        { name: 'Bootstrap',   slug: 'bootstrap',  url: 'https://getbootstrap.com' },
      ]
    },
    {
      id: 'security', label: 'SECURITY LAYER', color: '#23f6a5',
      dp: [58, 26], mp: [30, 31],
      skills: [
        { name: 'Spring Security', slug: 'springsecurity', url: 'https://spring.io/projects/spring-security' },
        { name: 'OAuth2',          slug: 'auth0',          url: 'https://oauth.net/2/' },
        { name: 'JWT',             slug: 'jsonwebtokens',  url: 'https://jwt.io' },
        { name: 'RBAC',            slug: 'auth0',          url: 'https://auth0.com' },
        { name: 'SSL/TLS',         slug: 'letsencrypt',    url: 'https://letsencrypt.org' },
        { name: 'API Security',    slug: 'owasp',          url: 'https://owasp.org' },
      ]
    },
    {
      id: 'data', label: 'DATA LAYER', color: '#60a5fa',
      dp: [88, 28], mp: [74, 41],
      skills: [
        { name: 'PostgreSQL',    slug: 'postgresql',      url: 'https://postgresql.org' },
        { name: 'MySQL',         slug: 'mysql',           url: 'https://mysql.com' },
        { name: 'Oracle SQL',    slug: 'oracle',          url: 'https://oracle.com/database' },
        { name: 'Redis',         slug: 'redis',           url: 'https://redis.io' },
        { name: 'Cassandra',     slug: 'apachecassandra', url: 'https://cassandra.apache.org' },
        { name: 'Elasticsearch', slug: 'elasticsearch',   url: 'https://elastic.co' },
        { name: 'MongoDB',       slug: 'mongodb',         url: 'https://mongodb.com' },
      ]
    },
    {
      id: 'messaging', label: 'MESSAGING LAYER', color: '#f59e0b',
      dp: [62, 72], mp: [24, 53],
      skills: [
        { name: 'Kafka',    slug: 'apachekafka',  url: 'https://kafka.apache.org' },
        { name: 'RabbitMQ', slug: 'rabbitmq',     url: 'https://rabbitmq.com' },
        { name: 'Google Pub/Sub', slug: 'googlecloud', url: 'https://cloud.google.com/pubsub' },
        { name: 'WebSockets', slug: 'socketdotio', url: 'https://developer.mozilla.org/docs/Web/API/WebSockets_API' },
        { name: 'Webhooks',  slug: 'webhook',      url: 'https://en.wikipedia.org/wiki/Webhook' },
        { name: 'Event-driven Architecture', slug: 'apachekafka', url: 'https://kafka.apache.org' },
      ]
    },
    {
      id: 'cloud', label: 'CLOUD & DEVOPS', color: '#06b6d4',
      dp: [40, 80], mp: [72, 62],
      skills: [
        { name: 'AWS',        slug: 'amazonaws',      url: 'https://aws.amazon.com' },
        { name: 'GCP',        slug: 'googlecloud',    url: 'https://cloud.google.com' },
        { name: 'Azure',      slug: 'microsoftazure', url: 'https://azure.microsoft.com' },
        { name: 'Docker',     slug: 'docker',         url: 'https://docker.com' },
        { name: 'Kubernetes', slug: 'kubernetes',     url: 'https://kubernetes.io' },
        { name: 'Jenkins',    slug: 'jenkins',        url: 'https://jenkins.io' },
        { name: 'GitLab CI/CD', slug: 'gitlab',       url: 'https://gitlab.com' },
        { name: 'Terraform',  slug: 'terraform',      url: 'https://terraform.io' },
        { name: 'Git',        slug: 'git',            url: 'https://git-scm.com' },
      ]
    },
    {
      id: 'observability', label: 'OBSERVABILITY', color: '#10b981',
      dp: [14, 70], mp: [26, 74],
      skills: [
        { name: 'Grafana',    slug: 'grafana',        url: 'https://grafana.com' },
        { name: 'Prometheus', slug: 'prometheus',     url: 'https://prometheus.io' },
        { name: 'Datadog',    slug: 'datadog',        url: 'https://datadoghq.com' },
        { name: 'CloudWatch', slug: 'amazoncloudwatch', url: 'https://aws.amazon.com/cloudwatch' },
        { name: 'Kibana',     slug: 'kibana',         url: 'https://elastic.co/kibana' },
      ]
    },
    {
      id: 'quality', label: 'QUALITY & AI', color: '#8b5cf6',
      dp: [82, 60], mp: [70, 84],
      skills: [
        { name: 'JUnit',   slug: 'junit5',  url: 'https://junit.org' },
        { name: 'Mockito', slug: 'mockito', url: 'https://site.mockito.org' },
        { name: 'Pytest',  slug: 'pytest',  url: 'https://pytest.org' },
        { name: 'SonarQube', slug: 'sonarqube', url: 'https://sonarsource.com/products/sonarqube' },
        { name: 'Postman', slug: 'postman', url: 'https://postman.com' },
        { name: 'RAG', slug: 'openai', url: 'https://en.wikipedia.org/wiki/Retrieval-augmented_generation' },
        { name: 'GitHub Copilot', slug: 'githubcopilot', url: 'https://github.com/features/copilot' },
      ]
    },
  ];

  // Target radians-per-second at 60fps equivalent
  const SPEEDS = [0.0014, 0.0017, 0.0011, 0.0019, 0.0016, 0.0013, 0.0015, 0.0020].map(s => s * 60);

  const univ = document.getElementById('sk-universe');
  if (!univ) return;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const hubEls   = {};
  const nodeEls  = {};
  const orbitEls = {};
  const angles   = {};
  let activeId   = null;
  let revealed   = false;
  let lastTime   = 0;

  /* ── Build DOM ─────────────────────────────────── */
  CLUSTERS.forEach((c, ci) => {
    const n = c.skills.length;
    angles[c.id] = c.skills.map((_, i) => (2 * Math.PI * i) / n);

    // Orbit ring
    const ring = document.createElement('div');
    ring.className = 'sk-orbit';
    ring.style.setProperty('--rd', ci * 90 + 'ms');
    ring.style.setProperty('--color', c.color);
    univ.appendChild(ring);
    orbitEls[c.id] = ring;

    // Hub
    const hub = document.createElement('button');
    hub.className = 'sk-hub';
    hub.dataset.cluster = c.id;
    hub.style.cssText = `--color:${c.color};--rd:${ci * 90}ms`;
    hub.textContent = c.label;
    hub.addEventListener('click', () => toggle(c.id));
    hub.addEventListener('mouseenter', () => orbitEls[c.id]?.classList.add('hovered'));
    hub.addEventListener('mouseleave', () => {
      const ring = orbitEls[c.id];
      if (ring) { ring.classList.remove('hovered'); void ring.offsetWidth; }
    });
    univ.appendChild(hub);
    hubEls[c.id] = hub;

    // Skill nodes
    nodeEls[c.id] = [];
    c.skills.forEach((sk, si) => {
      const el = document.createElement('div');
      el.className = 'sk-node';
      el.title = sk.name;
      el.style.setProperty('--rd', (ci * 90 + si * 28 + 80) + 'ms');
      const img = document.createElement('img');
      img.src = `https://api.iconify.design/simple-icons/${sk.slug}.svg?color=white`;
      img.alt = sk.name;
      img.loading = 'lazy';
      img.width = 15; img.height = 15;
      // Fallback: show text abbreviation if icon CDN 404s
      img.addEventListener('error', function () {
        const fb = document.createElement('span');
        fb.className = 'sk-icon-text';
        fb.textContent = sk.name.length <= 3 ? sk.name.toUpperCase() : sk.name.slice(0, 3).toUpperCase();
        this.replaceWith(fb);
      });
      const iconDiv = document.createElement('div');
      iconDiv.className = 'sk-node-icon';
      iconDiv.appendChild(img);
      const label = document.createElement('span');
      label.className = 'sk-node-label';
      label.textContent = sk.name;
      el.appendChild(iconDiv);
      el.appendChild(label);
      // Pass cluster color so expanded circle ring uses it
      el.style.setProperty('--color', c.color);
      el.addEventListener('click', () => toggle(c.id));
      el.addEventListener('mouseenter', () => orbitEls[c.id]?.classList.add('hovered'));
      el.addEventListener('mouseleave', () => {
        const ring = orbitEls[c.id];
        if (ring) { ring.classList.remove('hovered'); void ring.offsetWidth; }
      });
      univ.appendChild(el);
      nodeEls[c.id].push(el);
    });
  });

  /* ── Starfield ──────────────────────────── */
  const STAR_COUNT = 90;
  const starfield = document.createElement('div');
  starfield.className = 'sk-starfield';
  starfield.setAttribute('aria-hidden', 'true');
  univ.appendChild(starfield);

  for (let i = 0; i < STAR_COUNT; i++) {
    const s = document.createElement('div');
    s.className = 'sk-star';
    const sx = Math.random() * 100;
    const sy = Math.random() * 100;
    const size = (1 + Math.random() * 2).toFixed(1);          // 1–3 px
    const bright = (0.5 + Math.random() * 0.5).toFixed(2);    // 0.5–1.0
    const dur = (2 + Math.random() * 3).toFixed(1);           // 2–5s twinkle
    const del = (Math.random() * 4).toFixed(1);               // stagger

    s.style.cssText = `--x:${sx}%;--y:${sy}%;--sz:${size}px;--bright:${bright};--dur:${dur}s;--del:${del}s`;

    // Pre-compute warp vector toward center
    const dx = (50 - sx) / 100 * univ.offsetWidth;
    const dy = (50 - sy) / 100 * univ.offsetHeight;
    const ang = Math.atan2(50 - sy, 50 - sx) * (180 / Math.PI);
    const dist = Math.hypot(50 - sx, 50 - sy);                // 0–70 ish
    const warpDelay = Math.max(0, (70 - dist) * 4);           // closer = earlier

    s.style.setProperty('--dx', dx.toFixed(0) + 'px');
    s.style.setProperty('--dy', dy.toFixed(0) + 'px');
    s.style.setProperty('--ang', ang.toFixed(1) + 'deg');
    s.style.setProperty('--wd', warpDelay.toFixed(0) + 'ms');

    starfield.appendChild(s);
  }

  /* ── Toggle cluster ────────────────────────────── */
  function toggle(id) {
    const closing = activeId === id;
    if (activeId) setExpanded(activeId, false);
    activeId = closing ? null : id;
    if (!closing) setExpanded(id, true);
    // Focus dim: highlight active cluster, fade rest
    univ.classList.toggle('focused', !closing);
  }

  function setExpanded(id, on) {
    hubEls[id]?.classList.toggle('active', on);
    orbitEls[id]?.classList.toggle('active', on);
    nodeEls[id]?.forEach(n => n.classList.toggle('expanded', on));
  }

  /* ── Orbit radius — capped by nearest neighbour + container edges ── */
  function getRadius(cluster, W, H, mob) {
    const [px, py] = mob ? cluster.mp : cluster.dp;
    const cx = W * px / 100;
    const cy = H * py / 100;
    // How far we can orbit before hitting a container edge (18 px clearance for icon half-size)
    const clearance = 18;
    const distToEdge = Math.min(cx - clearance, W - cx - clearance, cy - clearance, H - cy - clearance);
    // Minimum distance to any other cluster center
    let minDist = Infinity;
    CLUSTERS.forEach(other => {
      if (other.id === cluster.id) return;
      const [ox, oy] = mob ? other.mp : other.dp;
      minDist = Math.min(minDist, Math.hypot(W * ox / 100 - cx, H * oy / 100 - cy));
    });
    // Desired radius based on skill count
    const base    = mob ? 70 : Math.max(68, W * 0.085);
    const desired = Math.max(50, base * Math.sqrt(cluster.skills.length / 4));
    // Cap at nearest-neighbour gap AND container edge — whichever is smaller
    return Math.min(desired, minDist * 0.44, Math.max(30, distToEdge));
  }

  /* ── RAF loop ──────────────────────────────────── */
  function frame(ts) {
    const now = ts * 0.001; // seconds
    const delta = lastTime ? Math.min(now - lastTime, 0.1) : 0;
    lastTime = now;

    const W = univ.offsetWidth;
    const H = univ.offsetHeight;
    if (!W || !H) {
      if (!reduced) requestAnimationFrame(frame);
      return;
    }
    const mob = W < 768;

    CLUSTERS.forEach((c, ci) => {
      const [px, py] = mob ? c.mp : c.dp;
      const cx = W * px / 100;
      const cy = H * py / 100;
      const r  = getRadius(c, W, H, mob);
      const ang = angles[c.id];

      // Hub position
      const hub = hubEls[c.id];
      if (hub) { hub.style.left = cx + 'px'; hub.style.top = cy + 'px'; }

      // Orbit ring
      const ring = orbitEls[c.id];
      if (ring) {
        ring.style.left   = cx + 'px';
        ring.style.top    = cy + 'px';
        ring.style.width  = r * 2 + 'px';
        ring.style.height = r * 2 + 'px';
      }

      // Radius breathing — ±4% organic pulse, unique phase per cluster
      const breathe = 1.0 + 0.04 * Math.sin(now * 0.7 + ci * 1.3);
      const rLive = r * breathe;

      // Skill node positions — 3D tilted orbits with depth-based scaling
      const TILT = 0.47; // cos(62°) — compresses Y to match CSS rotateX(62deg)
      const dir = ci % 2 === 0 ? 1 : -1;
      ang.forEach((a, i) => {
        ang[i] = a + dir * SPEEDS[ci] * delta;
        const el = nodeEls[c.id]?.[i];
        if (el) {
          const cosA = Math.cos(ang[i]);
          const sinA = Math.sin(ang[i]);
          const nx = cx + rLive * cosA;
          const ny = cy + rLive * sinA * TILT;

          // Depth: sinA > 0 → below center → closer to viewer
          const depth = (1 + sinA) / 2;           // 0 = far, 1 = near
          const sc = 0.55 + 0.45 * depth;         // 0.55–1.0
          const zIdx = sinA > 0 ? 12 : 8;

          el.style.transform = `translate3d(${nx}px,${ny}px,0) translate(-50%,-50%) scale(${sc.toFixed(3)})`;
          el.style.zIndex = String(zIdx);
        }
      });
    });

    if (!reduced) requestAnimationFrame(frame);
  }

  /* ── Scroll reveal with warp sequence ───────── */
  let warped = false;
  new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !warped) {
      warped = true;

      // Phase 1: warp stars toward center
      univ.classList.add('warping');

      // Phase 2: after warp + burst, reveal constellation
      setTimeout(() => {
        revealed = true;
        univ.classList.add('revealed');
      }, 2200);

      // Phase 3: auto-select a cluster after everything settles
      setTimeout(() => { if (!activeId) toggle('core'); }, 2800);
    }
  }, { threshold: 0.12 }).observe(univ);

  requestAnimationFrame(frame);
})();
</script>
