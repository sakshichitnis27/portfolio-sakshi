---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vismay Tiwari - Backend Systems Engineer',
  description = 'Database-heavy backend engineer building revenue-critical distributed systems across payments, subscriptions, search, LLM tooling, Kafka, Redis, Kubernetes, and AWS.',
} = Astro.props;

const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="backend engineer, distributed systems, python, golang, kafka, redis, aws, cloud, portfolio" />
  <meta name="theme-color" content="#050005" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${assetBase}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.95/build/spline-viewer.js"></script>
</head>
<body>
  
  <div class="stage-loader" id="stage-loader" aria-hidden="true">
    <div class="spline-bh-wrapper" id="spline-bh">
      <spline-viewer url={`${assetBase}/blackhole.splinecode`}></spline-viewer>
    </div>
    <div class="stellar-sun-wrapper" id="stellar-sun">
      <div class="stellar-plasma"></div>
      <div class="stellar-core"></div>
    </div>
    <canvas id="ldr-canvas"></canvas>
  </div>

  <canvas id="fluid-canvas" aria-hidden="true"></canvas>
  <div class="fluid-depth" aria-hidden="true">
    <span class="depth-ring depth-ring-a"></span>
    <span class="depth-ring depth-ring-b"></span>
    <span class="depth-scan"></span>
  </div>
  <div class="page-progress" id="page-progress" aria-hidden="true"></div>

  <div class="cursor" id="cursor"></div>
  <div class="cursor-follower" id="cursor-follower"></div>
  <canvas id="comet-cursor" aria-hidden="true"></canvas>

  <slot />

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fluidCanvas = document.getElementById('fluid-canvas');
    const loader = document.getElementById('stage-loader');
    let fluidInstance;
    const accentFrames = [
      ['#1e50ff', '#6622cc', '#00ccff', '#10d9a0', '#ffffff'],   // sapphire / violet / cyan / emerald / ice
      ['#10d9a0', '#d4a017', '#c0476a', '#0d9488', '#8b5cf6'],   // emerald / gold / mehroom / teal / violet
      ['#c0476a', '#d47320', '#8b5cf6', '#1e50ff', '#10d9a0'],   // mehroom / copper / violet / sapphire / emerald
    ];

    function hexToRgb(hex) {
      const value = hex.replace('#', '');
      return [
        parseInt(value.slice(0, 2), 16),
        parseInt(value.slice(2, 4), 16),
        parseInt(value.slice(4, 6), 16),
      ];
    }

    function mixHex(a, b, t) {
      const ar = hexToRgb(a);
      const br = hexToRgb(b);
      const mixed = ar.map((channel, index) => Math.round(channel + (br[index] - channel) * t));
      return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
    }

    function animateAccent(now) {
      const phase = (Math.sin(now * 0.00018) + 1) / 2;
      const segment = phase < 0.5 ? [0, 1, phase * 2] : [1, 2, (phase - 0.5) * 2];
      const [from, to, t] = segment;
      const root = document.documentElement;
      root.style.setProperty('--nebula-accent', mixHex(accentFrames[from][0], accentFrames[to][0], t));
      root.style.setProperty('--nebula-accent-2', mixHex(accentFrames[from][1], accentFrames[to][1], t));
      root.style.setProperty('--nebula-accent-3', mixHex(accentFrames[from][2], accentFrames[to][2], t));
      root.style.setProperty('--nebula-accent-4', mixHex(accentFrames[from][3], accentFrames[to][3], t));
      root.style.setProperty('--nebula-accent-5', mixHex(accentFrames[from][4], accentFrames[to][4], t));
      if (!reduceMotion.matches) requestAnimationFrame(animateAccent);
    }

    requestAnimationFrame(animateAccent);

    let fluidReady;
    function bootFluid() {
      if (!fluidCanvas || reduceMotion.matches) {
        document.documentElement.classList.add('is-reduced-motion');
        fluidReady = Promise.resolve();
        return;
      }

      fluidReady = import('../scripts/FluidBackground.js').then(FluidBackground => {
        fluidInstance = new FluidBackground.default(fluidCanvas, {
          flowScale: window.innerWidth < 720 ? 0.9 : 1.12,
          paused: true,
        });
      }).catch(error => {
        document.documentElement.classList.add('fluid-fallback');
        console.warn('Fluid background failed to start', error);
      });
    }

    requestAnimationFrame(bootFluid);

    let loaderFinished = false;
    function finishLoader() {
      if (loaderFinished) return;
      loaderFinished = true;
      document.documentElement.classList.add('loader-done');
      window.setTimeout(() => {
        loader?.remove();
        // Wait for the async fluid import to resolve before resuming
        (fluidReady || Promise.resolve()).then(() => {
          if (fluidInstance) {
            fluidInstance.resume();
            requestAnimationFrame(() =>
              requestAnimationFrame(() =>
                document.documentElement.classList.add('fluid-ready')
              )
            );
          } else {
            document.documentElement.classList.add('fluid-ready');
          }
        });
      }, 1050);
    }

    function scheduleLoaderFinish(delay = 650) {
      window.setTimeout(finishLoader, delay);
    }

    // Fallbacks in case the animation loop fails to run
    window.addEventListener('load', () => scheduleLoaderFinish(13500), { once: true });
    window.setTimeout(finishLoader, 15000);

    // ── Solar system → black hole canvas loader ──────────
    (function () {
      const canvas = document.getElementById('ldr-canvas');
      const stellarSun = document.getElementById('stellar-sun');
      const splineBh = document.getElementById('spline-bh');
      
      // ── Mobile detection: skip heavy Spline 3D, use lightweight canvas BH ──
      const isMobileLdr = window.innerWidth < 768
        || !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      
      if (isMobileLdr) {
        // Remove Spline viewer entirely — its WASM engine + 3D model cause massive lag
        const viewer = document.querySelector('spline-viewer');
        if (viewer) viewer.remove();
      } else {
        // Desktop: remove the "Built with Spline" watermark from the shadow DOM
        const viewer = document.querySelector('spline-viewer');
        if (viewer) {
          const removeLogo = setInterval(() => {
            const logo = viewer.shadowRoot?.querySelector('#logo');
            if (logo) {
              logo.style.display = 'none';
              clearInterval(removeLogo);
            }
          }, 100);
        }
      }

      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let W, H, CX, CY, raf;

      function resize() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
        CX = W / 2; CY = H / 2;
      }
      resize();
      window.addEventListener('resize', resize);

      // Quote pool — one picked randomly each page load
      const QUOTES = [
        ['\u201cEven the darkest night will end', 'and the sun will rise.\u201d \u2014 Victor Hugo'],
        ['\u201cPatience is bitter,', 'but its fruit is sweet.\u201d \u2014 Rousseau'],
        ['\u201cIn the middle of difficulty', 'lies opportunity.\u201d \u2014 Einstein'],
        ['\u201cThe darker the night,', 'the brighter the stars.\u201d \u2014 Dostoevsky'],
        ['\u201cAfter every storm', 'the sun will smile.\u201d \u2014 William Cullen Bryant'],
      ];
      const QUOTE = QUOTES[Math.floor(Math.random() * QUOTES.length)];

      // Stars — dense field with z-depth, drift velocities, and stronger twinkle
      const STAR_COLORS = [
        [255,255,255], [255,255,255], [255,255,255], [255,255,255], // most are white
        [255,240,200], [200,220,255], [255,210,210], [220,255,240], // warm tints
      ];
      const stars = Array.from({ length: isMobileLdr ? 160 : 420 }, () => {
        const z = Math.random();
        const speed = (1 - z) * 0.012 + 0.002;  // close stars drift faster
        const angle = Math.random() * Math.PI * 2;
        const col = STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)];
        return {
          x:   Math.random(),
          y:   Math.random(),
          z,
          r:   (Math.random() * 0.8 + 0.3) * (1 - z * 0.5),
          a:   (Math.random() * 0.3 + 0.7) * (1 - z * 0.4),
          tw:  Math.random() * Math.PI * 2,
          twS: 0.8 + Math.random() * 2.5,       // twinkle speed
          twA: 0.3 + Math.random() * 0.2,       // twinkle amplitude (stronger)
          vx:  Math.cos(angle) * speed,          // drift velocity
          vy:  Math.sin(angle) * speed,
          col,
        };
      });

      // Comets — bright streaks that fly across the scene
      const ALL_COMETS = [
        { x: -0.05, y: 0.15, ang: 0.35,  speed: 0.09, tailLen: 110, size: 2.2, delay: 1200, period: 6500 },
        { x: 1.05,  y: 0.08, ang: 2.65,  speed: 0.07, tailLen: 85,  size: 1.8, delay: 2800, period: 7500 },
        { x: 0.5,   y:-0.05, ang: 1.85,  speed: 0.11, tailLen: 100, size: 2.0, delay: 4200, period: 8000 },
        { x: -0.05, y: 0.75, ang: 0.15,  speed: 0.08, tailLen: 95,  size: 1.6, delay: 5500, period: 7000 },
        { x: 1.05,  y: 0.55, ang: 2.95,  speed: 0.10, tailLen: 105, size: 2.4, delay: 3200, period: 8500 },
      ];
      const COMETS = (isMobileLdr ? ALL_COMETS.slice(0, 2) : ALL_COMETS).map(c => ({
        ...c,
        cx: c.x, cy: c.y,
        dx: Math.cos(c.ang) * c.speed,
        dy: Math.sin(c.ang) * c.speed,
        active: false,
        nextT: c.delay,
        trail: [],
      }));

      // 4 planets — uneven spacing, inner falls first, last one late
      const PLANETS = [
        { r:3.8, oR:68,  spd:2.2,  ang:0.8,  col:'#d0d0d0', glo:'#909090', tc:'208,208,208', delay:    0 },
        { r:5.5, oR:112, spd:1.35, ang:2.4,  col:'#5bc8ff', glo:'#0096dd', tc:'91,200,255',  delay:  600 },
        { r:5,   oR:150, spd:0.92, ang:3.9,  col:'#ff7755', glo:'#dd3311', tc:'255,119,85',  delay: 1100 },
        { r:9,   oR:205, spd:0.52, ang:5.2,  col:'#ffb347', glo:'#dd7700', tc:'255,179,71',  delay: 2100 },
      ];
      const trails = PLANETS.map(() => []);
      const MAX_TRAIL = 32;

      // Corona ray seed table (fixed random per session)
      const CORONA = Array.from({ length: 60 }, (_, i) => ({
        ph0: Math.random() * Math.PI * 2,  // low-freq phase
        ph1: Math.random() * Math.PI * 2,  // mid-freq phase
        ph2: Math.random() * Math.PI * 2,  // high-freq phase
        w:   0.5 + Math.random(),           // base width
      }));

      // Timeline (ms)
      const T_SOLAR      = 4800;   // free orbit phase ends
      const T_PULL_START = T_SOLAR; // first planet starts falling in
      const T_PULL_END   = 8400;   // last planet fully consumed
      const T_BH_START   = T_PULL_END;
      const T_BH_FULL    = 12200;  // BH warp phase lasts ~3.8s
      const T_FLASH      = 13200;  // white flash

      // Easing
      function ease5(t) { return t*t*t*(t*(6*t-15)+10); }
      function easeOut3(t) { return 1 - Math.pow(1-t,3); }
      function clamp(v,a,b) { return Math.max(a,Math.min(b,v)); }
      function lerp(a,b,t) { return a+(b-a)*t; }

      // ── Draw helpers ──────────────────────────────────────

      function drawStars(t, pull, dt) {
        const p = ease5(pull);
        const dtSec = dt * 0.001;
        for (const s of stars) {
          // Drift movement (wrap at edges)
          if (p < 0.5) {
            s.x += s.vx * dtSec;
            s.y += s.vy * dtSec;
            if (s.x < -0.02) s.x = 1.02;
            if (s.x > 1.02)  s.x = -0.02;
            if (s.y < -0.02) s.y = 1.02;
            if (s.y > 1.02)  s.y = -0.02;
          }

          const sx = s.x * W, sy = s.y * H;
          const twk  = (1 - s.twA) + s.twA * (0.5 + 0.5 * Math.sin(s.tw + t * 0.001 * s.twS));
          const alpha = s.a * twk * (1 - p * 0.18);
          if (alpha < 0.01) continue;
          const [cr, cg, cb] = s.col;

          if (p > 0.04) {
            // Parallax warp: close stars (low z) drift faster toward BH
            const depthSpeed = (1 - s.z) * 0.22 + 0.02;
            const drift = p * depthSpeed + p * 0.015 * Math.sin(s.tw + t * 0.0006 * s.twS);
            const x = lerp(sx, CX, drift);
            const y = lerp(sy, CY, drift);
            const dx = x - CX, dy = y - CY;
            const dist = Math.sqrt(dx * dx + dy * dy) || 1;
            const nx = dx / dist, ny = dy / dist;
            const streak = p * p * (90 + (1 - s.z) * 130) * (0.5 + s.r);
            const x2 = x + nx * streak;
            const y2 = y + ny * streak;
            const gl = ctx.createLinearGradient(x, y, x2, y2);
            gl.addColorStop(0, `rgba(${cr},${cg},${cb},${alpha.toFixed(3)})`);
            gl.addColorStop(1, `rgba(${cr},${cg},${cb},0)`);
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(x2, y2);
            ctx.strokeStyle = gl;
            ctx.lineWidth   = s.r * 1.6;
            ctx.stroke();
          } else {
            // Glow halo for brighter stars
            if (s.r > 0.5 && alpha > 0.4) {
              ctx.beginPath();
              ctx.arc(sx, sy, s.r * 3, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(${cr},${cg},${cb},${(alpha * 0.12).toFixed(3)})`;
              ctx.fill();
            }
            ctx.beginPath();
            ctx.arc(sx, sy, s.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${cr},${cg},${cb},${alpha.toFixed(3)})`;
            ctx.fill();
          }
        }
      }

      function drawComets(t, pull, dt) {
        const dtSec = dt * 0.001;
        for (const c of COMETS) {
          if (!c.active && t >= c.nextT && pull < 0.02) {
            c.active = true;
            c.cx = c.x;
            c.cy = c.y;
            c.dx = Math.cos(c.ang) * c.speed;
            c.dy = Math.sin(c.ang) * c.speed;
            c.trail = [];
          }
          if (!c.active) continue;

          // During BH pull, curve comets toward center (gravitational deflection)
          if (pull > 0.04) {
            const toCX = 0.5 - c.cx, toCY = 0.5 - c.cy;
            const dist = Math.hypot(toCX, toCY) || 0.01;
            const pullF = pull * pull * 0.8 / (dist + 0.08); // stronger pull
            c.dx += (toCX / dist) * pullF * dtSec;
            c.dy += (toCY / dist) * pullF * dtSec;
          }

          c.cx += c.dx * dtSec;
          c.cy += c.dy * dtSec;

          const px = c.cx * W, py = c.cy * H;
          c.trail.push({x: px, y: py});
          // Tail gets longer during stretch
          const maxT = pull > 0.1 ? 25 : 12;
          if (c.trail.length > maxT) c.trail.shift();

          // Consumed by BH? Fade near center
          const distC = Math.hypot(c.cx - 0.5, c.cy - 0.5);
          if (pull > 0.2 && distC < 0.04) { c.active = false; continue; }

          // Off-screen reset (only when no BH pull)
          if (pull < 0.02 && (c.cx < -0.15 || c.cx > 1.15 || c.cy < -0.15 || c.cy > 1.15)) {
            c.active = false;
            c.nextT = t + c.period + Math.random() * 2000;
            continue;
          }

          const fadeAlpha = pull > 0.15 ? clamp(distC / 0.15, 0, 1) : 1;

          // Draw trailing curve (smoothed with quadratic curves)
          if (c.trail.length > 2) {
            ctx.beginPath();
            ctx.moveTo(c.trail[0].x, c.trail[0].y);
            for (let i = 1; i < c.trail.length - 1; i++) {
              const xc = (c.trail[i].x + c.trail[i+1].x) / 2;
              const yc = (c.trail[i].y + c.trail[i+1].y) / 2;
              ctx.quadraticCurveTo(c.trail[i].x, c.trail[i].y, xc, yc);
            }
            ctx.lineTo(c.trail[c.trail.length-1].x, c.trail[c.trail.length-1].y);
            
            const tg = ctx.createLinearGradient(c.trail[0].x, c.trail[0].y, px, py);
            tg.addColorStop(0, `rgba(180,220,255,0)`);
            tg.addColorStop(0.5, `rgba(180,220,255,${0.3 * fadeAlpha})`);
            tg.addColorStop(1, `rgba(255,255,255,${0.9 * fadeAlpha})`);
            ctx.strokeStyle = tg;
            ctx.lineWidth = c.size * 1.5;
            ctx.lineCap = 'round';
            ctx.stroke();
          }

          // Bright head
          ctx.globalAlpha = fadeAlpha;
          ctx.beginPath(); ctx.arc(px, py, c.size, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,255,255,0.9)';
          ctx.fill();

          // Subtle glow
          const gg = ctx.createRadialGradient(px, py, 0, px, py, c.size * 5);
          gg.addColorStop(0, 'rgba(180,210,255,0.2)');
          gg.addColorStop(1, 'rgba(180,210,255,0)');
          ctx.beginPath(); ctx.arc(px, py, c.size * 5, 0, Math.PI * 2);
          ctx.fillStyle = gg; ctx.fill();
          ctx.globalAlpha = 1;
        }
      }

      function drawSun(t, pull) {
        const p     = ease5(pull);
        const scale = 1 - p * 0.97;
        const R     = 28 * scale;
        
        // Sync the HTML CSS sun with the black hole gravity pull
        if (stellarSun) {
          if (p > 0) {
            stellarSun.style.transform = `translate(-50%, -50%) scale(${Math.max(0, 0.65 * (1 - p * 1.5))})`;
            stellarSun.style.opacity = Math.max(0, 1 - p * 1.2);
            stellarSun.style.filter = `blur(${p * 20}px)`;
          } else {
            stellarSun.style.transform = `translate(-50%, -50%) scale(0.65)`;
            stellarSun.style.opacity = 1;
            stellarSun.style.filter = 'none';
          }
        }
        
        if (R < 0.5) return;
        const pulse = 1 + 0.04 * Math.sin(t * 0.0018);
        const a     = clamp(1 - p * 1.15, 0, 1);
        if (a <= 0) return;
        
        // Return immediately so we don't draw the fake canvas sun anymore!
        return;

        // Deep atmospheric glow layers
        for (const [hr, op, rv, gv, bv] of [
          [220, 0.010, 255, 145, 35],
          [145, 0.022, 255, 165, 45],
          [92,  0.052, 255, 140, 20],
          [60,  0.10,  255, 115, 10],
          [38,  0.20,  255,  95,  5],
        ]) {
          const gr = hr * scale;
          const grd = ctx.createRadialGradient(CX, CY, R * 0.45, CX, CY, gr);
          grd.addColorStop(0,   `rgba(${rv},${gv},${bv},${op * a})`);
          grd.addColorStop(0.6, `rgba(${rv},${Math.round(gv*0.6)},0,${op * 0.15 * a})`);
          grd.addColorStop(1,   'rgba(0,0,0,0)');
          ctx.beginPath(); ctx.arc(CX, CY, gr, 0, Math.PI * 2);
          ctx.fillStyle = grd; ctx.fill();
        }

        // Corona rays — 60 thin radial streaks with noise-like length variation
        ctx.save();
        ctx.filter = 'blur(1.2px)';
        ctx.globalAlpha = a * 0.6;
        for (let i = 0; i < CORONA.length; i++) {
          const ang = (i / CORONA.length) * Math.PI * 2 + t * 0.000055;
          const cr  = CORONA[i];
          // Multi-frequency noise: mimics turbulent corona without Perlin
          const nz  = 0.55
            + 0.24 * Math.sin(cr.ph0 + t * 0.00038)
            + 0.14 * Math.sin(cr.ph1 + t * 0.00065)
            + 0.07 * Math.sin(cr.ph2 + t * 0.00027);
          const len = R * (1.9 + 2.6 * clamp(nz, 0, 1)) * scale;
          const x1  = CX + Math.cos(ang) * R * 1.01;
          const y1  = CY + Math.sin(ang) * R * 1.01;
          const x2  = CX + Math.cos(ang) * len;
          const y2  = CY + Math.sin(ang) * len;
          const gl  = ctx.createLinearGradient(x1, y1, x2, y2);
          gl.addColorStop(0,    'rgba(255,230,110,0.9)');
          gl.addColorStop(0.3,  'rgba(255,160,40,0.35)');
          gl.addColorStop(1,    'rgba(255,80,0,0)');
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = gl;
          ctx.lineWidth   = cr.w;
          ctx.stroke();
        }
        ctx.filter = 'none';
        ctx.restore();

        // Chromosphere — thin pink/magenta ring just outside photosphere
        ctx.save();
        ctx.globalAlpha = a * 0.65;
        ctx.beginPath(); ctx.arc(CX, CY, R * 1.055 * pulse, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255,195,170,0.95)';
        ctx.lineWidth   = R * 0.075;
        ctx.shadowColor = '#ff9060'; ctx.shadowBlur = R * 0.55;
        ctx.stroke(); ctx.shadowBlur = 0;
        ctx.restore();

        // Photosphere — limb-darkened sphere
        ctx.globalAlpha = a;
        const sg = ctx.createRadialGradient(
          CX - R * 0.30, CY - R * 0.32, 0,
          CX, CY, R * pulse
        );
        sg.addColorStop(0,    '#fffff0');
        sg.addColorStop(0.11, '#fff4a0');
        sg.addColorStop(0.40, '#ffbf20');
        sg.addColorStop(0.72, '#ff7800');
        sg.addColorStop(0.90, '#ff3c00');
        sg.addColorStop(1,    '#880e00');
        ctx.beginPath(); ctx.arc(CX, CY, R * pulse, 0, Math.PI * 2);
        ctx.fillStyle = sg; ctx.fill();
        ctx.globalAlpha = 1;
      }

      function drawPlanet(pl, idx, t) {
        // Each planet has its own pull timeline — inner planets fall first
        const startT  = T_PULL_START + pl.delay;
        const window_ = T_PULL_END - startT;
        const p       = (window_ > 0 && t > startT) ? ease5(clamp((t - startT) / window_, 0, 1)) : 0;
        // Moderate angular velocity builds up so it curves smoothly instead of forming jagged spiderwebs
        const ang = pl.ang + (t / 1000) * pl.spd + p * p * 12 * pl.spd;
        const oR  = pl.oR * (1 - p * 0.985);
        if (oR < 2) return;
        const x     = CX + Math.cos(ang) * oR;
        const y     = CY + Math.sin(ang) * oR;
        // Stay fully visible until 88% in, then quick fade as it hits the sun
        const alpha = p < 0.88 ? 1.0 : clamp((1 - p) / 0.12, 0, 1);

        // Procedurally generated, mathematically perfect smooth trail
        if (alpha > 0.01) {
          const TIME_HISTORY = 900; // ms of history
          const STEPS = isMobileLdr ? 18 : 45;
          let lastX = x, lastY = y;
          
          for (let i = 1; i <= STEPS; i++) {
            const frac = i / STEPS;
            const pastT = t - frac * TIME_HISTORY;
            
            const p_past = (window_ > 0 && pastT > startT) ? ease5(clamp((pastT - startT) / window_, 0, 1)) : 0;
            const ang_past = pl.ang + (pastT / 1000) * pl.spd + p_past * p_past * 12 * pl.spd;
            const oR_past = pl.oR * (1 - p_past * 0.985);
            
            const px = CX + Math.cos(ang_past) * oR_past;
            const py = CY + Math.sin(ang_past) * oR_past;
            
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(px, py);
            
            const weight = 1 - frac; // 1 at the planet, 0 at the tail
            ctx.strokeStyle = `rgba(${pl.tc},${(weight * alpha * 0.4).toFixed(3)})`;
            ctx.lineWidth   = pl.r * weight * 0.85;
            ctx.lineCap     = 'round';
            ctx.stroke();
            
            lastX = px;
            lastY = py;
          }
        }

        // Orbit ring fades as pull starts
        if (p < 0.22) {
          ctx.beginPath(); ctx.arc(CX, CY, oR, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(255,255,255,${0.07 * (1 - p / 0.22)})`;
          ctx.lineWidth   = 0.5; ctx.stroke();
        }

        if (alpha <= 0.01) return;

        // Glow halo
        const gg = ctx.createRadialGradient(x, y, 0, x, y, pl.r * 4);
        gg.addColorStop(0, pl.glo); gg.addColorStop(1, 'transparent');
        ctx.globalAlpha = alpha * 0.48;
        ctx.beginPath(); ctx.arc(x, y, pl.r * 4, 0, Math.PI * 2);
        ctx.fillStyle = gg; ctx.fill();

        // Body (Realistic directional lighting)
        ctx.globalAlpha = alpha;
        const angleToSun = Math.atan2(CY - y, CX - x);
        const bg = ctx.createLinearGradient(
          x + Math.cos(angleToSun) * pl.r, y + Math.sin(angleToSun) * pl.r,
          x - Math.cos(angleToSun) * pl.r, y - Math.sin(angleToSun) * pl.r
        );
        // Day side, terminator, and dark night side
        bg.addColorStop(0,   pl.col);
        bg.addColorStop(0.4, pl.glo);
        bg.addColorStop(1,   '#08040a');
        
        ctx.beginPath(); ctx.arc(x, y, pl.r, 0, Math.PI * 2);
        ctx.fillStyle = bg; ctx.fill();
        
        // Atmospheric rim
        ctx.strokeStyle = pl.col;
        ctx.lineWidth = 0.5;
        ctx.stroke();

        // Saturn ring (kept logic in case we want rings on other planets)
        if (pl.ring && p < 0.5) {
          ctx.globalAlpha = alpha * (1 - p / 0.5) * 0.85;
          ctx.save();
          ctx.translate(x, y); ctx.rotate(0.45); ctx.scale(1, 0.28);
          const rg = ctx.createLinearGradient(-pl.r * 2.5, 0, pl.r * 2.5, 0);
          rg.addColorStop(0,   'transparent');
          rg.addColorStop(0.2, 'rgba(255,215,100,0.9)');
          rg.addColorStop(0.5, 'rgba(255,235,145,0.6)');
          rg.addColorStop(0.8, 'rgba(255,200,80,0.9)');
          rg.addColorStop(1,   'transparent');
          ctx.beginPath(); ctx.arc(0, 0, pl.r * 2.5, 0, Math.PI * 2);
          ctx.strokeStyle = rg; ctx.lineWidth = 4; ctx.stroke();
          ctx.restore();
        }
        ctx.globalAlpha = 1;
      }

      // Accretion disk half — smooth radial gradient fill using translate+scale
      // (scale y by tilt so ctx.arc circles become the correct ellipses in screen space)
      function drawDiskHalf(bR, p, warm) {
        const inner = bR * 1.08;
        const outer = bR * 2.75;
        ctx.save();
        ctx.translate(CX, CY);
        ctx.scale(1, 0.30);   // y-squash: circles → ellipses matching disk tilt
        const g = ctx.createRadialGradient(0, 0, inner, 0, 0, outer);
        if (warm) {
          g.addColorStop(0,    `rgba(255,228,92,${0.95*p})`);
          g.addColorStop(0.18, `rgba(255,162,38,${0.80*p})`);
          g.addColorStop(0.45, `rgba(238,80,18,${0.42*p})`);
          g.addColorStop(0.78, `rgba(155,30,5,${0.12*p})`);
          g.addColorStop(1,    'rgba(0,0,0,0)');
        } else {
          g.addColorStop(0,    `rgba(228,112,255,${0.42*p})`);
          g.addColorStop(0.35, `rgba(125,52,218,${0.22*p})`);
          g.addColorStop(0.65, `rgba(72,22,172,${0.08*p})`);
          g.addColorStop(1,    'rgba(0,0,0,0)');
        }
        ctx.beginPath();
        ctx.arc(0, 0, outer, 0, Math.PI * 2, false); // outer boundary (cw)
        ctx.arc(0, 0, inner, 0, Math.PI * 2, true);  // inner cutout (ccw)
        ctx.fillStyle = g;
        ctx.fill();
        ctx.restore();
      }

      function drawBlackHole(pull, t) {
        // Desktop: use the 3D Spline black hole
        if (!isMobileLdr && splineBh) {
          if (pull > 0) {
            const p = easeOut3(pull);
            splineBh.style.opacity = p;
            splineBh.style.transform = `translate(-50%, -50%) scale(${0.08 + p * 0.10})`;
            splineBh.style.pointerEvents = 'auto';
          } else {
            splineBh.style.opacity = 0;
          }
          if (pull <= 0) return;
          return; // Desktop skips canvas BH — Spline handles it
        }
        
        // Mobile: lightweight canvas-drawn black hole
        if (pull <= 0) return;
        const p = easeOut3(pull);
        const bR = 42 * p;  // event horizon radius
        if (bR < 1) return;

        // Outer glow layers
        for (const [rm, rv, gv, bv, op] of [[4.0,80,30,180,0.05],[3.0,255,150,40,0.09],[2.2,200,100,255,0.07]]) {
          const go = ctx.createRadialGradient(CX, CY, bR * 0.5, CX, CY, bR * rm);
          go.addColorStop(0,   `rgba(${rv},${gv},${bv},${op*p})`);
          go.addColorStop(0.6, `rgba(${rv},${gv},${bv},${op*0.15*p})`);
          go.addColorStop(1,   'rgba(0,0,0,0)');
          ctx.beginPath(); ctx.arc(CX, CY, bR * rm, 0, Math.PI * 2);
          ctx.fillStyle = go; ctx.fill();
        }

        // Back disk (cool, dim)
        ctx.save();
        ctx.beginPath(); ctx.rect(0, 0, W, CY); ctx.clip();
        drawDiskHalf(bR, p, false);
        ctx.restore();

        // Event horizon
        ctx.beginPath(); ctx.arc(CX, CY, bR, 0, Math.PI * 2);
        ctx.fillStyle = '#000'; ctx.fill();

        // Photon ring — pulsing
        const ringPulse = 1 + 0.06 * Math.sin(t * 0.003);
        ctx.beginPath(); ctx.arc(CX, CY, bR * 1.24 * ringPulse, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(255,195,80,${0.45*p})`;
        ctx.lineWidth   = 4;
        ctx.shadowColor = '#ff9400'; ctx.shadowBlur = 20 * p;
        ctx.stroke(); ctx.shadowBlur = 0;
        // Inner ring
        ctx.beginPath(); ctx.arc(CX, CY, bR * 1.12, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(255,245,170,${0.9*p})`;
        ctx.lineWidth   = 1.5;
        ctx.stroke();

        // Front disk (warm, bright)
        ctx.save();
        ctx.beginPath(); ctx.rect(0, CY, W, H); ctx.clip();
        drawDiskHalf(bR, p, true);
        ctx.restore();

        // Relativistic hot spot at bottom
        const hsY = CY + bR * 1.08;
        const hsG = ctx.createRadialGradient(CX, hsY, 0, CX, hsY, bR * 1.0);
        hsG.addColorStop(0,    `rgba(255,250,220,${0.85*p})`);
        hsG.addColorStop(0.3,  `rgba(255,175,55,${0.45*p})`);
        hsG.addColorStop(0.7,  `rgba(200,80,20,${0.12*p})`);
        hsG.addColorStop(1,    'rgba(0,0,0,0)');
        ctx.beginPath(); ctx.arc(CX, hsY, bR * 1.0, 0, Math.PI * 2);
        ctx.fillStyle = hsG; ctx.fill();

        // Re-punch event horizon
        ctx.beginPath(); ctx.arc(CX, CY, bR, 0, Math.PI * 2);
        ctx.fillStyle = '#000'; ctx.fill();

      }

      function drawFlash(flash) {
        if (flash <= 0) return;
        const i = flash < 0.35 ? flash / 0.35 : 1 - (flash - 0.35) / 0.65;
        const g = ctx.createRadialGradient(CX, CY, 0, CX, CY, Math.hypot(W, H) * 0.75);
        g.addColorStop(0,    `rgba(255,255,255,${i})`);
        g.addColorStop(0.28, `rgba(210,190,255,${i * 0.72})`);
        g.addColorStop(0.65, `rgba(90,70,220,${i * 0.28})`);
        g.addColorStop(1,    'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, W, H);
      }

      function drawText(t, sunPull) {
        const rs  = Math.max(10, Math.min(14, W * 0.018));
        const qs  = Math.max(13, Math.min(18, W * 0.022));
        // Anchor near the top of the screen
        const by  = H * 0.14;
        ctx.save();
        ctx.textAlign = 'center';

        // LOADING fades in fast, fades out when planets start falling
        const ldA = clamp(t / 900, 0, 1) * clamp(1 - sunPull / 0.45, 0, 1);
        // Quote fades in at 1.8s, fades out with loading text
        const qA  = ldA * clamp((t - 1800) / 1200, 0, 1);

        // Dark scrim behind loading + quote
        if (ldA > 0.01) {
          const scrimAlpha = Math.max(ldA, qA) * 0.72;
          const padX = W * 0.44;
          const topY = by - rs * 2.0;
          const botY = qA > 0.01 ? by + qs * 3.4 : by + rs * 0.6;
          ctx.save();
          ctx.globalAlpha = scrimAlpha;
          ctx.fillStyle   = '#000007';
          const rx = CX - padX, rw = padX * 2, ry = topY, rh = botY - topY;
          ctx.beginPath();
          ctx.roundRect(rx, ry, rw, rh, 10);
          ctx.fill();
          ctx.restore();
        }

        if (ldA > 0.01) {
          const dots = '•'.repeat(1 + (Math.floor(t / 480) % 3));
          ctx.globalAlpha = ldA;
          ctx.fillStyle   = '#d0e4ff';
          ctx.font        = `500 ${rs}px 'JetBrains Mono', monospace`;
          ctx.fillText(`LOADING  ${dots}`, CX, by);
        }

        if (qA > 0.01) {
          ctx.globalAlpha = qA;
          ctx.fillStyle   = '#ffe9a0';
          ctx.font        = `400 italic ${qs}px 'Space Grotesk', sans-serif`;
          ctx.fillText(QUOTE[0], CX, by + qs * 1.6);
          ctx.fillText(QUOTE[1], CX, by + qs * 2.9);
        }

        ctx.restore();
      }

      // Pre-warm: render 4 silent frames at t=0 so the GPU compiles blur/gradient
      // shaders and JS JIT-compiles the hot paths before the animation starts.
      // After warm-up, hold static for 250ms so the scene is visible and calm
      // before movement begins — avoids the first-frame jitter on cold load.
      let t0 = null;
      let prevTs = 0;
      let preWarm = 4;
      let holdUntil = null;
      const HOLD_MS = 250;
      function frame(ts) {
        let t;
        if (preWarm > 0) {
          t = 0;
          preWarm--;
          if (preWarm === 0) holdUntil = ts + HOLD_MS; // start hold after warm-up
        } else if (holdUntil !== null && ts < holdUntil) {
          t = 0; // hold static — scene visible, nothing moving yet
        } else {
          if (t0 === null) t0 = ts; // lock animation clock on first moving frame
          t = ts - t0;
        }
        // sunPull: drives sun shrink + text fade as planets fall in
        const sunPull = t > T_PULL_START ? clamp((t - T_PULL_START) / (T_PULL_END - T_PULL_START), 0, 1) : 0;
        // bhPull: drives black hole formation, only starts AFTER all planets consumed
        const bhPull  = t > T_BH_START   ? clamp((t - T_BH_START)  / (T_BH_FULL  - T_BH_START),  0, 1) : 0;
        const flash   = t > T_BH_FULL    ? clamp((t - T_BH_FULL)   / (T_FLASH    - T_BH_FULL),   0, 1) : 0;
        const dt = t0 !== null && prevTs > 0 ? ts - prevTs : 16;
        

        ctx.clearRect(0, 0, W, H);
        drawStars(t, bhPull, dt);
        drawComets(t, bhPull, dt);
        drawBlackHole(bhPull, t);
        drawSun(t, sunPull);
        for (let i = 0; i < PLANETS.length; i++) drawPlanet(PLANETS[i], i, t);
        drawFlash(flash);
        drawText(t, sunPull);
        prevTs = ts;
        if (t >= T_FLASH && typeof finishLoader === 'function') {
          finishLoader();
        }
        if (t < T_FLASH + 300) raf = requestAnimationFrame(frame);
      }
      raf = requestAnimationFrame(frame);
    })();

    reduceMotion.addEventListener?.('change', () => {
      if (reduceMotion.matches && fluidInstance?.destroy) {
        fluidInstance.destroy();
        document.documentElement.classList.add('is-reduced-motion');
      }
    });

    const cursor = document.getElementById('cursor');
    const follower = document.getElementById('cursor-follower');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let fx = 0;
    let fy = 0;
    let mx = 0;
    let my = 0;

    if (finePointer) {
      const cometCanvas = document.getElementById('comet-cursor');
      let cCtx = null;
      let cw = 0, ch = 0;
      let tailPoints = [];
      const TAIL_LEN = 16;
      let isHovering = false;
      let hoverVal = 0;

      if (cometCanvas) {
        cCtx = cometCanvas.getContext('2d', { alpha: true });
        const resizeComet = () => {
          cw = window.innerWidth;
          ch = window.innerHeight;
          cometCanvas.width = cw;
          cometCanvas.height = ch;
        };
        window.addEventListener('resize', resizeComet, {passive: true});
        resizeComet();
        
        tailPoints = Array.from({length: TAIL_LEN}, () => ({x: cw/2, y: ch/2}));
      }

      document.addEventListener('mousemove', (event) => {
        mx = event.clientX;
        my = event.clientY;
        if (cursor) {
          cursor.style.left = `${mx}px`;
          cursor.style.top = `${my}px`;
        }
      });

      function animateCursor() {
        fx += (mx - fx) * 0.12;
        fy += (my - fy) * 0.12;
        if (follower) {
          follower.style.left = `${fx}px`;
          follower.style.top = `${fy}px`;
        }

        // Render smooth tail attached to follower (fx, fy)
        if (cCtx && (fx !== 0 || fy !== 0)) {
          cCtx.clearRect(0, 0, cw, ch);
          hoverVal += ( (isHovering ? 1 : 0) - hoverVal ) * 0.15;

          tailPoints[0].x = fx;
          tailPoints[0].y = fy;
          for (let i = 1; i < TAIL_LEN; i++) {
            tailPoints[i].x += (tailPoints[i-1].x - tailPoints[i].x) * 0.42;
            tailPoints[i].y += (tailPoints[i-1].y - tailPoints[i].y) * 0.42;
          }

          const cColor = document.documentElement.style.getPropertyValue('--nebula-accent').trim() || '#00d2ff';
          
          for (let i = 1; i < TAIL_LEN; i++) {
            cCtx.beginPath();
            cCtx.moveTo(tailPoints[i-1].x, tailPoints[i-1].y);
            cCtx.lineTo(tailPoints[i].x, tailPoints[i].y);
            cCtx.strokeStyle = cColor;
            cCtx.lineWidth = (TAIL_LEN - i) / TAIL_LEN * (3.5 + hoverVal * 2.5);
            cCtx.lineCap = 'round';
            cCtx.globalAlpha = Math.max(0, (TAIL_LEN - i) / TAIL_LEN);
            cCtx.stroke();
          }
          cCtx.globalAlpha = 1;
        }

        requestAnimationFrame(animateCursor);
      }
      animateCursor();
      
      // Bind hover state tracking for the comet tail thickness
      const bindHover = () => {
        document.querySelectorAll('a, button, [data-cursor], .skill-ring__item').forEach((el) => {
          if (!el.dataset.tailAttached) {
             el.dataset.tailAttached = 'true';
             el.addEventListener('mouseenter', () => isHovering = true);
             el.addEventListener('mouseleave', () => isHovering = false);
          }
        });
      };
      bindHover();
      new MutationObserver(bindHover).observe(document.body, {childList: true, subtree: true});
    }

    document.querySelectorAll('a, button, [data-cursor]').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        if (cursor) {
          cursor.style.width = '20px';
          cursor.style.height = '20px';
          cursor.style.opacity = '0.5';
        }
        if (follower) {
          follower.style.width = '52px';
          follower.style.height = '52px';
        }
      });
      el.addEventListener('mouseleave', () => {
        if (cursor) {
          cursor.style.width = '10px';
          cursor.style.height = '10px';
          cursor.style.opacity = '1';
        }
        if (follower) {
          follower.style.width = '32px';
          follower.style.height = '32px';
        }
      });
    });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.fade-up').forEach((el) => revealObserver.observe(el));

    // ── Directional scroll entry effects ────────────────
    (function () {
      const aboutDriver  = document.getElementById('about-driver');
      const expDriver    = document.getElementById('exp-driver');
      const skillsDriver = document.getElementById('skills-driver');
      if (!aboutDriver && !expDriver && !skillsDriver) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Skip on narrow screens — large translates are too jarring on mobile
      if (window.innerWidth < 640) return;

      // Pre-promote animated elements to compositor layers to avoid repaints
      const aboutCont  = aboutDriver  && aboutDriver.querySelector('.about-container');
      const expRiver   = expDriver    && expDriver.querySelector('.career-river');
      const skillsCont = skillsDriver && skillsDriver.querySelector('.skills-section');
      if (aboutCont)  aboutCont.style.willChange  = 'transform';
      if (expRiver)   expRiver.style.willChange   = 'transform';
      if (skillsCont) skillsCont.style.willChange = 'transform';

      const settled = { about: false, exp: false, skills: false };

      // Ease-out curve: fast start, decelerates to rest — prevents snap-to-place feel
      function easeOut(t) { return 1 - (1 - t) * (1 - t); }

      // Returns 0→1 progress: section must be 22% into viewport, then eases over 45% of viewport
      function entryP(el) {
        const raw = Math.max(0, 1 - el.getBoundingClientRect().top / window.innerHeight);
        const delay = 0.22;
        if (raw < delay) return 0;
        return easeOut(Math.min(1, (raw - delay) * 2.4));
      }

      function updateEntries() {
        if (aboutCont && !settled.about) {
          const p = entryP(aboutDriver);
          if (p >= 1) {
            aboutCont.style.transform = '';
            aboutCont.style.willChange = 'auto';
            settled.about = true;
          } else if (p > 0) {
            aboutCont.style.transform = `translateX(${(1 - p) * 44}vw)`;
          }
        }
        if (expRiver && !settled.exp) {
          const p = entryP(expDriver);
          if (p >= 1) {
            expRiver.style.transform = '';
            expRiver.style.willChange = 'auto';
            settled.exp = true;
          } else if (p > 0) {
            expRiver.style.transform = `rotate(${(1 - p) * -14}deg) scale(${0.9 + p * 0.1})`;
          }
        }
        if (skillsCont && !settled.skills) {
          const p = entryP(skillsDriver);
          if (p >= 1) {
            skillsCont.style.transform = '';
            skillsCont.style.willChange = 'auto';
            settled.skills = true;
          } else if (p > 0) {
            skillsCont.style.transform = `translateX(${-(1 - p) * 44}vw)`;
          }
        }
        // Stop listening once all sections have settled
        if (settled.about && settled.exp && settled.skills) {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      }

      // rAF-gated scroll handler — coalesces multiple scroll events per frame into one DOM update
      let _ticking = false;
      function onScroll() {
        if (!_ticking) {
          requestAnimationFrame(() => {
            updateEntries();
            _ticking = false;
          });
          _ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateEntries();
    })();

    const progress = document.getElementById('page-progress');
    function updateProgress() {
      if (!progress) return;
      const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      progress.style.transform = `scaleX(${Math.min(Math.max(window.scrollY / max, 0), 1)})`;
    }
    updateProgress();
    document.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
  </script>
</body>
</html>
